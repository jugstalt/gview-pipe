<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <Version>0.1.0</Version>
    <Authors>jugstalt</Authors>
    <Product>gView.Pipe</Product>
    <RepositoryUrl>https://github.com/jugstalt/gview-pipe</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- examples of nodes next to their class (ADR 0043), found by PipeNodeExample.Load -->
  <ItemGroup>
    <None Remove="**\*.examples.json" />
    <Content Remove="**\*.examples.json" />
    <EmbeddedResource Include="**\*.examples.json" Exclude="bin\**;obj\**" />
  </ItemGroup>

</Project>
