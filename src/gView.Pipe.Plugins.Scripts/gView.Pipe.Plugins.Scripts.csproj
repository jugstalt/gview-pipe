<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Run Scripts node (bat/cmd, PowerShell, Python, sh) from released folders or Git repositories. An external plugin: install it only where running scripts is wanted.</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- the contracts come from the host; never ship them with the plugin -->
    <ProjectReference Include="..\gView.Pipe.Abstraction\gView.Pipe.Abstraction.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- provided by the host at runtime (Microsoft.Extensions.* are shared) -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Extensions.Http" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="gView.Pipe.Plugins.Scripts.Tests" />
  </ItemGroup>

  <!--
    Installs the plugin into the Shell for development: src/gView.Pipe.Shell/plugins/<name>/ (ignored by Git).
    Other hosts copy the build output into their own plugin folder.
  -->
  <Target Name="InstallIntoShell" AfterTargets="Build" Condition="'$(InstallPipePlugin)' != 'false'">
    <ItemGroup>
      <PluginFiles Include="$(OutDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFiles="@(PluginFiles->'$(MSBuildThisFileDirectory)..\gView.Pipe.Shell\plugins\$(AssemblyName)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
