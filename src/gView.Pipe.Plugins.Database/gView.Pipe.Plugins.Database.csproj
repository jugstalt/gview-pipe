<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>SQL node for SQL Server, PostgreSQL and SQLite. An external plugin: loaded from plugins/gView.Pipe.Plugins.Database/ in its own load context.</Description>
    <!-- the plugin folder needs all dependencies, including the native SQLite and SQL Server libraries -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- English messages only; keeps the plugin folder small -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- the contracts come from the host; never ship them with the plugin -->
    <ProjectReference Include="..\gView.Pipe.Abstraction\gView.Pipe.Abstraction.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Npgsql" />
    <!-- lifts the transitive System.Security.Cryptography.Pkcs of SqlClient above the versions with known advisories -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <!--
    Installs the plugin into the Shell for development: src/gView.Pipe.Shell/plugins/<name>/ (ignored by Git).
    Other hosts copy the build output into their own plugin folder.
  -->
  <Target Name="InstallIntoShell" AfterTargets="Build" Condition="'$(InstallPipePlugin)' != 'false'">
    <ItemGroup>
      <PluginFiles Include="$(OutDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFiles="@(PluginFiles->'$(MSBuildThisFileDirectory)..\gView.Pipe.Shell\plugins\$(AssemblyName)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
