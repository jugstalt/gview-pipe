@page "/jobs/{WorkflowId}/{ExecutionId}"
@implements IDisposable
@inject PipePortalClient Client
@inject PipePortalOptions Options
@inject ISnackbar Snackbar

<PageTitle>@(_run?.WorkflowName ?? "Run")</PageTitle>

<MudBreadcrumbs Items="_crumbs" Class="pa-0 mb-2" />

@if (_error is not null && _run is null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_run is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudText Typo="Typo.h5" Class="mb-1">@(_run.WorkflowName ?? _run.WorkflowId)</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">Started @(_run.StartedAt?.LocalDateTime.ToString("g")) · run number @_run.ExecutionId</MudText>

    <MudPaper Outlined="true" Class="pa-4">
        <RunOutcome Run="_run" />
        @if (_run.IsRunning)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-3" />
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">You can leave this page; the run goes on and is listed under My runs.</MudText>
            @if (_run.CanCancel)
            {
                <MudButton Class="mt-2" Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Stop" OnClick="StopAsync">Stop</MudButton>
            }
        }
    </MudPaper>
}

@code {
    [Parameter] public string WorkflowId { get; set; } = "";
    [Parameter] public string ExecutionId { get; set; } = "";

    private readonly CancellationTokenSource _stopped = new();
    private readonly List<BreadcrumbItem> _crumbs = [new("My runs", href: "jobs")];
    private PortalRun? _run;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _ = PollAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _run = await Client.GetRunAsync(WorkflowId, ExecutionId, _stopped.Token);
            _error = null;
        }
        catch (PipePortalException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(Math.Max(1, Options.PollSeconds)));
        try
        {
            while (_run?.IsRunning == true && await timer.WaitForNextTickAsync(_stopped.Token))
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // the page was left
        }
    }

    private async Task StopAsync()
    {
        try
        {
            await Client.CancelAsync(WorkflowId, ExecutionId);
            Snackbar.Add("Stopping the run...", Severity.Info);
        }
        catch (PipePortalException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    public void Dispose()
    {
        _stopped.Cancel();
        _stopped.Dispose();
    }
}
