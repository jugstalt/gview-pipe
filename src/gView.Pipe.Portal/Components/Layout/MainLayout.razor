@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject PipePortalOptions Options
@inject PipeAuthenticationOptions AuthOptions

<MudThemeProvider Theme="PortalTheme.Default" IsDarkMode="_dark" @ref="_themeProvider" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Class="mr-2" />
        <MudText Typo="Typo.h6" Class="mr-6">@Options.Title</MudText>
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ViewList" Class="gview-pipe-shell-nav">Workflows</MudNavLink>
        <MudNavLink Href="jobs" Icon="@Icons.Material.Filled.History" Class="gview-pipe-shell-nav">My runs</MudNavLink>
        <MudSpacer />
        @if (AuthOptions.Mode != PipeAuthenticationMode.None && _userName is not null)
        {
            <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" aria-label="Account">
                <MudMenuItem Disabled="true">@_userName</MudMenuItem>
                @* a full request: the logout clears the cookie (and the session at the identity provider) *@
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="@(() => Navigation.NavigateTo("account/logout", forceLoad: true))">Sign out</MudMenuItem>
            </MudMenu>
        }
    </MudAppBar>
    <MudMainContent Class="gview-pipe-portal-main">
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private MudThemeProvider? _themeProvider;
    private bool _dark;
    private string? _userName;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is not null)
        {
            _userName = (await AuthenticationState).User.Identity?.Name;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _themeProvider is not null)
        {
            _dark = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }
}
