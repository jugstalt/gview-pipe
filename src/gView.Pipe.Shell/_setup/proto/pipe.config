{
  // address of the app, one port per instance on the same machine. Wins over the default of the
  // start scripts (ASPNETCORE_URLS=http://localhost:5100); the Windows service passes its port with --urls.
  //"urls": "http://localhost:5101",
  "Pipe": {
    "DataPath": "data",
    // the environment this instance runs in, and the ones workflows and groups can choose (DEFAULT always exists)
    "Environment": "DEFAULT",
    "Environments": [ "TEST", "STAGE", "PROD" ],
    // instance variables per environment; more can be added on the Variables page, which wins
    //"Variables": {
    //  "DATABASE_SERVER": { "DEFAULT": "db-test", "PROD": "db-prod" }
    //},
    //"SecretVariables": [ "DATABASE_PASSWORD" ],
    "PluginPath": "plugins",
    "FileRoots": {
      "files": "files"
    },
    "Scripts": {
      "ScriptRoots": {
        "scripts": "scripts"
      },
      "RepositoriesPath": "data/script-repos",
      // remove the underscore to use the Gitea of the AppHost (ADD_GITEA)
      "GitServers_": {
        "local-gitea": {
          "Provider": "gitea",
          "Url": "http://localhost:3000",
          "Owner": "dev",
          "CredentialId": "gitea-local"
        }
      }
    }
  }
}
