{
  "Pipe": {
    "DataPath": "data",
    "PluginPath": "plugins",
    "FileRoots": {
      "files": "files"
    },
    "Scripts": {
      "ScriptRoots": {
        "scripts": "scripts"
      },
      "RepositoriesPath": "data/script-repos",
      // remove the underscore to use the Gitea of the AppHost (ADD_GITEA)
      "GitServers_": {
        "local-gitea": {
          "Provider": "gitea",
          "Url": "http://localhost:3000",
          "Owner": "dev",
          "CredentialId": "gitea-local"
        }
      }
    }
  }
}
