{
  // address of the app, one port per instance on the same machine. Wins over the default of the
  // start scripts (ASPNETCORE_URLS=http://localhost:5100); the Windows service passes its port with --urls.
  //"urls": "http://localhost:5101",
  "Pipe": {
    "DataPath": "data",
    // the environment this instance runs in, and the ones workflows and groups can choose (DEFAULT always exists)
    "Environment": "DEFAULT",
    "Environments": [ "TEST", "STAGE", "PROD" ],
    // instance variables per environment; more can be added on the Variables page, which wins
    //"Variables": {
    //  "DATABASE_SERVER": { "DEFAULT": "db-test", "PROD": "db-prod" }
    //},
    //"SecretVariables": [ "DATABASE_PASSWORD" ],
    // executions kept per workflow, by count and by age (0 = no limit); workflows can override both
    "ExecutionRetention": 50,
    "ExecutionRetentionDays": 0,
    // days the audit log (data/audit) is kept, in whole months; 0 = no limit
    "AuditRetentionDays": 365,
    // error workflow of all workflows whose group and workflow don't set one, e.g. "error-mail";
    // the address users reach the app at, for links to failed runs in notifications
    //"ErrorWorkflowId": "error-mail",
    //"PublicUrl": "https://pipe.example.com",
    // the user portal (ADR 0027): runs per user at the same time, days results and values are kept,
    // the workflow that sends the mail when a run is done (ADR 0029) and the address of the portal for its link
    //"Portal": {
    //  "MaxRunsPerUser": 3,
    //  "HistoryDays": 30,
    //  "NotifyWorkflowId": "portal-mail",
    //  "PublicUrl": "https://portal.example.com"
    //},
    // the user portal (ADR 0027): runs per user at the same time, days results and values are kept,
    // the workflow that sends the mail when a run is done (ADR 0029) and the address of the portal for its link
    //"Portal": {
    //  "MaxRunsPerUser": 3,
    //  "HistoryDays": 30,
    //  "NotifyWorkflowId": "portal-mail",
    //  "PublicUrl": "https://portal.example.com"
    //},
    "PluginPath": "plugins",
    "FileRoots": {
      "files": "files"
    },
    "Scripts": {
      "ScriptRoots": {
        "scripts": "scripts"
      },
      "RepositoriesPath": "data/script-repos",
      // remove the underscore to use the Gitea of the AppHost (ADD_GITEA)
      "GitServers_": {
        "local-gitea": {
          "Provider": "gitea",
          "Url": "http://localhost:3000",
          "Owner": "dev",
          "CredentialId": "gitea-local"
        }
      }
    }
  }
}
