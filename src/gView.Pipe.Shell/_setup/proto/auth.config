{
  "Pipe": {
    "Auth": {
      // none: no login (only on localhost or a protected network) | forms: users below | oidc: identity provider
      // Docker: Pipe__Auth__Mode=forms, or just PIPE_ADMIN_PASSWORD (user "admin", or PIPE_ADMIN_USER)
      "Mode": "none",
      // minutes without a request until the login expires
      "SessionMinutes": 480,
      // behind a reverse proxy (X-Forwarded-Proto/-For/-Host), so OIDC builds https redirect URIs
      "UseForwardedHeaders": false,
      // role of signed-in users without one of their own: viewer | operator | editor | admin (ADR 0021);
      // admin keeps the behavior from before roles, switch to viewer once the roles below are set up
      "DefaultRole": "admin",

      // mode forms: create a hash with "dotnet gView.Pipe.Shell.dll --hash-password <password>"
      //"Users": [
      //  { "Name": "admin", "PasswordHash": "pbkdf2-sha256$...", "Role": "admin" },
      //  { "Name": "ada", "Password": "plain text, logs a warning", "Role": "viewer", "GroupRoles": { "billing": "editor" } }
      //],
      "LoginAttemptsPerMinute": 10,

      // mode oidc: the client needs the redirect URIs <app>/signin-oidc and <app>/signout-callback-oidc
      "Oidc": {
        "Authority": "https://localhost:8443",
        "ClientId": "local-gview-pipe",
        "ClientSecret": "secret",
        "Scopes": [ "openid", "profile", "role" ],
        "RoleClaimType": "role",
        "NameClaimType": "name",
        // a user needs one of these roles; empty: every authenticated user
        "RequiredRoles": [ "gview-pipe" ],
        // values of the role claim -> role, or role@group for the workflows of one group
        "RoleMappings": {
          //"pipe-admins": "admin",
          //"pipe-billing": "editor@billing"
        }
      }
    }
  }
}
