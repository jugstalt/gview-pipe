<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>gView.Pipe application shell: layout, routing and service composition only.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\gView.Pipe.Core\gView.Pipe.Core.csproj" />
    <ProjectReference Include="..\gView.Pipe.AspNetCore\gView.Pipe.AspNetCore.csproj" />
    <ProjectReference Include="..\gView.Pipe.Razor\gView.Pipe.Razor.csproj" />
    <!-- built-in nodes; referenced only so the dll lands in the output folder, discovered like any plugin -->
    <ProjectReference Include="..\gView.Pipe.Plugins\gView.Pipe.Plugins.csproj" />
    <ProjectReference Include="..\Aspire\gView.Pipe.ServiceDefaults\gView.Pipe.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" />
    <!-- runs as a Windows service when started by the service manager (gview-pipe-service.bat) -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <ItemGroup>
    <!-- seeded into an empty workflow store on first start -->
    <None Include="..\..\samples\workflows\*.json" Link="samples\workflows\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\groups.json" Link="samples\groups.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- prototype of _config/pipe.config, copied on first start -->
    <None Update="_setup\proto\pipe.config" CopyToOutputDirectory="PreserveNewest" />
    <!-- local configuration of the developer; never copied or published -->
    <None Remove="_config\**" />
    <Content Remove="_config\**" />
  </ItemGroup>

</Project>
