@using Microsoft.Extensions.Logging

@if (Run is null)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Run the workflow, or pick an execution from the history, to see this node's input, output and logs.</MudText>
}
else
{
    <MudStack Spacing="2">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="StatusColor">@Run.Status</MudChip>
            @if (Run.StartedAt is { } started && Run.FinishedAt is { } finished)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@((finished - started).TotalMilliseconds.ToString("0")) ms</MudText>
            }
            @if (Run.Pinned)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.PushPin">pinned data</MudChip>
            }
            @if (Run.Attempts > 1)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Run.Attempts attempts</MudText>
            }
        </MudStack>

        @if (Run.Error is { } error)
        {
            <MudAlert Severity="Severity.Error" Dense="true">@error</MudAlert>
        }

        <MudTabs Elevation="0" Rounded="false" @bind-ActivePanelIndex="_tab" Class="gview-pipe-run-tabs" MinimumTabWidth="70px">
            <MudTabPanel Text="@($"Input ({Run.InputCounts.Values.Sum()})")">
                @if (OnSelectInputPath.HasDelegate && Run.Inputs?.Values.Any(i => i.Count > 0) == true)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Click a property to insert it as an expression into the last edited parameter.</MudText>
                }
                <PipeItemsView Items="Run.Inputs" Counts="Run.InputCounts" EmptyText="The node received no items." OnSelectPath="OnSelectInputPath" />
            </MudTabPanel>
            <MudTabPanel Text="@($"Output ({Run.OutputCounts.Values.Sum()})")">
                <PipeItemsView Items="Run.Outputs" Counts="Run.OutputCounts" EmptyText="The node produced no items." />
            </MudTabPanel>
            <MudTabPanel Text="@($"Logs ({Run.Logs.Count})")">
                @if (Run.Logs.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @(Run.Status == PipeNodeRunStatus.Running ? "Logs are shown when the node has finished." : "The node wrote no log entries.")
                    </MudText>
                }
                @foreach (var entry in Run.Logs)
                {
                    <div class="gview-pipe-log-entry @LevelClass(entry.Level)">
                        <span class="gview-pipe-log-time">@entry.Timestamp.LocalDateTime.ToString("HH:mm:ss.fff")</span>
                        <span class="gview-pipe-log-level">@LevelText(entry.Level)</span>
                        <span class="gview-pipe-log-message">@entry.Message</span>
                    </div>
                }
            </MudTabPanel>
        </MudTabs>
    </MudStack>
}

@code {
    [Parameter] public PipeNodeRun? Run { get; set; }

    /// <summary>When set, input properties are clickable and report their path (e.g. <c>$json.a.b</c>).</summary>
    [Parameter] public EventCallback<string> OnSelectInputPath { get; set; }

    // output first: that is what one usually looks for
    private int _tab = 1;

    private Color StatusColor => Run?.Status switch
    {
        PipeNodeRunStatus.Success => Color.Success,
        PipeNodeRunStatus.Error => Color.Error,
        PipeNodeRunStatus.Running => Color.Info,
        _ => Color.Default
    };

    static private string LevelText(LogLevel level) => level switch
    {
        LogLevel.Trace => "TRC",
        LogLevel.Debug => "DBG",
        LogLevel.Information => "INF",
        LogLevel.Warning => "WRN",
        LogLevel.Error => "ERR",
        LogLevel.Critical => "CRT",
        _ => ""
    };

    static private string? LevelClass(LogLevel level) => level switch
    {
        LogLevel.Warning => "warning",
        LogLevel.Error or LogLevel.Critical => "error",
        LogLevel.Trace or LogLevel.Debug => "debug",
        _ => null
    };
}
