@if (Run is null)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Run the workflow, or pick an execution from the history, to see this node's output.</MudText>
}
else
{
    <MudStack Spacing="2">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="StatusColor">@Run.Status</MudChip>
            @if (Run.StartedAt is { } started && Run.FinishedAt is { } finished)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@((finished - started).TotalMilliseconds.ToString("0")) ms</MudText>
            }
            @if (Run.Attempts > 1)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Run.Attempts attempts</MudText>
            }
        </MudStack>

        @if (Run.Error is { } error)
        {
            <MudAlert Severity="Severity.Error" Dense="true">@error</MudAlert>
        }

        @if (Run.Outputs is null)
        {
            @if (Run.OutputCounts.Count > 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Item data was not saved for this execution (@string.Join(", ", Run.OutputCounts.Select(c => $"{c.Key}: {c.Value}"))).
                </MudText>
            }
        }
        else if (Run.Outputs.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">No output.</MudText>
        }
        else
        {
            <MudTabs Elevation="0" Rounded="false" Class="gview-pipe-output-tabs">
                @foreach (var (port, items) in Run.Outputs)
                {
                    <MudTabPanel Text="@($"{port} ({items.Count})")">
                        @if (items.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">No items.</MudText>
                        }
                        @foreach (var (item, index) in items.Take(MaxItems).Select((item, index) => (item, index)))
                        {
                            <div class="gview-pipe-item">
                                <div class="gview-pipe-item-index">#@index</div>
                                <pre class="gview-pipe-code">@PipeJsonText.ToIndentedJson(item.Json)</pre>
                                @foreach (var (name, binary) in item.Binary)
                                {
                                    <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.AttachFile">@name: @binary.FileName (@binary.Length bytes)</MudChip>
                                }
                            </div>
                        }
                        @if (items.Count > MaxItems)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">… @(items.Count - MaxItems) more items</MudText>
                        }
                    </MudTabPanel>
                }
            </MudTabs>
        }
    </MudStack>
}

@code {
    private const int MaxItems = 50;

    [Parameter] public PipeNodeRun? Run { get; set; }

    private Color StatusColor => Run?.Status switch
    {
        PipeNodeRunStatus.Success => Color.Success,
        PipeNodeRunStatus.Error => Color.Error,
        PipeNodeRunStatus.Running => Color.Info,
        _ => Color.Default
    };
}
