@using Blazor.Diagrams
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Core.Anchors
@using Point = Blazor.Diagrams.Core.Geometry.Point
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Core.Models.Base
@using Blazor.Diagrams.Options
@using gView.Pipe.Abstraction.Data
@using gView.Pipe.Abstraction.Nodes
@using gView.Pipe.Abstraction.Serialization
@using gView.Pipe.Abstraction.Triggers
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IPipeWorkflowStore WorkflowStore
@inject IPipeWorkflowGroupStore GroupStore
@inject IPipeWorkflowRunner Runner
@inject IPipeTriggerManager TriggerManager
@inject IPipeNodeRegistry Registry
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject PipeEditorClipboard Clipboard
@inject IJSRuntime JS
@inject IPipeRunningExecutions RunningExecutions
@inject IPipeExecutionStore ExecutionStore

@*
    Workflow editor: node palette, canvas and a side panel for the selected node (or the workflow).
    The canvas owns topology and positions; node parameters and settings live on the PipeWorkflowNode objects.
*@

@* asks before unsaved changes are left behind: in-app navigation (also the back button) and closing the tab *@
<Microsoft.AspNetCore.Components.Routing.NavigationLock ConfirmExternalNavigation="_dirty" OnBeforeInternalNavigation="ConfirmLeaveAsync" />

<div class="gview-pipe-editor">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_workflow is null)
    {
        <MudAlert Severity="Severity.Warning" Class="ma-4">Workflow '@WorkflowId' not found.</MudAlert>
    }
    else
    {
        <div class="gview-pipe-editor-toolbar">
            @if (OnClose.HasDelegate)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" aria-label="Back" OnClick="() => OnClose.InvokeAsync(KnownGroup?.Id)" />
            }
            <MudText Typo="Typo.h6" Class="gview-pipe-editor-title">
                @if (KnownGroup is { } group)
                {
                    <span style="color:@PipeGroupVisuals.Accent(group.Color); margin-right:.35em">@group.Name ›</span>
                }
                @_workflow.Name
            </MudText>
            @if (_dirty)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">unsaved</MudChip>
            }
            <MudSpacer />
            <MudTooltip Text="Undo (Ctrl+Z on the canvas)">
                <MudIconButton Icon="@Icons.Material.Filled.Undo" aria-label="Undo" OnClick="Undo" Disabled="@(!CanUndo || _running)" />
            </MudTooltip>
            <MudTooltip Text="Redo (Ctrl+Y on the canvas)">
                <MudIconButton Icon="@Icons.Material.Filled.Redo" aria-label="Redo" OnClick="Redo" Disabled="@(!CanRedo || _running)" Class="mr-2" />
            </MudTooltip>
            <MudTooltip Text="Paste nodes (Ctrl+V on the canvas)">
                <MudIconButton Icon="@Icons.Material.Filled.ContentPaste" aria-label="Paste nodes" OnClick="PasteAsync" Class="mr-2" />
            </MudTooltip>
            <MudTooltip Text="@(_paletteHidden ? "Show the node palette" : "Hide the node palette")">
                <MudIconButton Icon="@Icons.Material.Filled.MenuOpen" aria-label="Toggle the node palette" OnClick="() => ToggleSideAsync(ResizeSide.Palette)"
                               Color="@(_paletteHidden ? Color.Default : Color.Primary)" />
            </MudTooltip>
            <MudTooltip Text="@(_panelHidden ? "Show the side panel" : "Hide the side panel")">
                <MudIconButton Icon="@Icons.Material.Filled.ViewSidebar" aria-label="Toggle the side panel" OnClick="() => ToggleSideAsync(ResizeSide.Panel)"
                               Color="@(_panelHidden ? Color.Default : Color.Primary)" Class="mr-2" />
            </MudTooltip>
            <MudTooltip Text="Active workflows have their triggers (e.g. cron) armed after saving">
                <MudSwitch T="bool" Value="_workflow.Active" ValueChanged="SetActive" Color="Color.Success" Label="Active" Class="mr-2" />
            </MudTooltip>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync" Class="mr-2" Disabled="_running">Save</MudButton>
            @if (_running)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop" OnClick="StopRun">Stop</MudButton>
            }
            else if (_watched is { IsRunning: true })
            {
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop" OnClick="StopWatchedAsync">Stop run</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="() => RunAsync()">Run</MudButton>
            }
        </div>

        @if (_watched is null && !_running && _othersRunning.Count > 0)
        {
            var newest = _othersRunning[0];
            <MudAlert Severity="Severity.Info" Dense="true" Class="gview-pipe-editor-banner"
                      ContentAlignment="HorizontalAlignment.Left">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <span>
                        @(_othersRunning.Count == 1 ? "Running now" : $"{_othersRunning.Count} runs right now")
                        (@newest.Mode, since @RunningFor(newest))
                    </span>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Visibility"
                               OnClick="() => WatchAsync(newest.ExecutionId)">Watch</MudButton>
                </MudStack>
            </MudAlert>
        }

        @* the splitters are dragged in the browser (gview-pipe-editor.js) *@
        <div class="gview-pipe-editor-body @(_paletteHidden ? "gview-pipe-hide-palette" : null) @(_panelHidden ? "gview-pipe-hide-panel" : null)" @ref="_body" style="--gview-pipe-palette-width:@(_paletteWidth)px;--gview-pipe-panel-width:@(_panelWidth)px">
            <PipeNodePalette OnAdd="AddNode" />
            <div class="gview-pipe-splitter" data-gview-pipe-splitter="palette" title="Drag to resize, double-click to reset"
                 @ondblclick="() => ResetWidth(ResizeSide.Palette)"></div>

            <div class="gview-pipe-editor-canvas">
                <CascadingValue Value="_diagram" IsFixed="true">
                    <DiagramCanvas Class="gview-pipe-canvas" />
                </CascadingValue>
                @if (_showDropHint)
                {
                    <div class="gview-pipe-canvas-hint">Hold <kbd>Shift</kbd> to drop the node into a connection</div>
                }
                @if (_watched is { IsRunning: true } watched)
                {
                    <div class="gview-pipe-canvas-status">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Visibility">
                            Watching · @watched.Mode · @RunningFor(watched)
                        </MudChip>
                        @if (_watchedOutdated)
                        {
                            <MudTooltip Text="The workflow was changed since this run started; nodes it ran may be missing here">
                                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" />
                            </MudTooltip>
                        }
                    </div>
                }
                else if (_execution is not null)
                {
                    <div class="gview-pipe-canvas-status">
                        <MudChip T="string" Size="Size.Small" Color="StatusColor(_execution.Status)" Variant="Variant.Filled">
                            @_execution.Status · @_execution.StartedAt.LocalDateTime.ToString("T")
                        </MudChip>
                        @if (!_running)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Clear" Size="Size.Small" aria-label="Clear run" OnClick="ClearExecution" />
                        }
                    </div>
                }
            </div>

            <div class="gview-pipe-splitter" data-gview-pipe-splitter="panel" title="Drag to resize, double-click to reset"
                 @ondblclick="() => ResetWidth(ResizeSide.Panel)"></div>
            <div class="gview-pipe-editor-panel">
                @if (_selected is not null)
                {
                    <PipeNodePanel @key="_selected" Model="_selected" Workflow="_workflow"
                                   IsNameTaken="IsNameTaken"
                                   Running="_running"
                                   PinnedOutputs="@_workflow.PinData?.GetValueOrDefault(_selected.Node.Id)"
                                   OnPinChanged="SetPinData"
                                   OnChanged="NodeChanged"
                                   OnRunToHere="() => RunAsync(_selected.Node.Id)"
                                   OnDuplicate="DuplicateSelectionAsync"
                                   OnCopy="CopySelectionAsync"
                                   OnDelete="DeleteSelected"
                                   LiveLines="@(LiveActive ? LiveLinesOf(_selected.Node.Id) : null)" />
                }
                else
                {
                    @if (LiveActive)
                    {
                        <div class="pa-4 pb-0">
                            <PipeLiveOutput Lines="_liveLines.ToList()" ShowNodeName="true" Running="true" Title="Live output of the run" />
                        </div>
                    }
                    <PipeWorkflowPanel Workflow="_workflow" HistoryVersion="_historyVersion"
                                       SelectedExecutionId="@_execution?.Id"
                                       OnChanged="@(() => MarkDirty("workflow"))"
                                       OnSelectExecution="ShowExecution" />
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string WorkflowId { get; set; } = "";

    // ---- resizable side bars ----

    private enum ResizeSide { Palette, Panel }

    private const double DefaultPaletteWidth = 220, DefaultPanelWidth = 380;
    private const string WidthsKey = "gview-pipe.editor.widths";

    private double _paletteWidth = DefaultPaletteWidth;
    private double _panelWidth = DefaultPanelWidth;
    private ElementReference _body;
    private IJSObjectReference? _editorModule, _editorScript;
    private DotNetObjectReference<PipeEditor>? _self;
    private bool _editorScriptStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // the body appears once the workflow is loaded
        // renders can follow each other while the module loads: start it only once
        if (_editorScriptStarted || string.IsNullOrEmpty(_body.Id))
        {
            return;
        }
        _editorScriptStarted = true;

        try
        {
            _editorModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/gView.Pipe.Razor/js/gview-pipe-editor.js");
            _self ??= DotNetObjectReference.Create(this);
            _editorScript = await _editorModule.InvokeAsync<IJSObjectReference>("init", _body, _self);

            // side bars the user hid last time
            if (await JS.InvokeAsync<string?>("localStorage.getItem", HiddenKey) is { } hidden)
            {
                _paletteHidden = hidden.Contains("palette");
                _panelHidden = hidden.Contains("panel");
                StateHasChanged();
            }

            // widths the user chose last time, kept in the browser
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", WidthsKey);
            if (stored?.Split(';') is [var palette, var panel]
                && double.TryParse(palette, System.Globalization.CultureInfo.InvariantCulture, out var p)
                && double.TryParse(panel, System.Globalization.CultureInfo.InvariantCulture, out var q))
            {
                _paletteWidth = await ClampWidthAsync(ResizeSide.Palette, p);
                _panelWidth = await ClampWidthAsync(ResizeSide.Panel, q);
                StateHasChanged();
            }
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    // hidden side bars stay rendered (CSS only), so the panel keeps its state
    private bool _paletteHidden, _panelHidden;
    private const string HiddenKey = "gview-pipe.editor.hidden";

    private async Task ToggleSideAsync(ResizeSide side)
    {
        if (side == ResizeSide.Palette)
        {
            _paletteHidden = !_paletteHidden;
        }
        else
        {
            _panelHidden = !_panelHidden;
        }

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", HiddenKey, $"{(_paletteHidden ? "palette" : "")};{(_panelHidden ? "panel" : "")}");
        }
        catch (JSException) { }
    }

    /// <summary>Called by gview-pipe-editor.js on Ctrl+S.</summary>
    [JSInvokable]
    public async Task SaveShortcut()
    {
        if (!_running && _workflow is not null)
        {
            await InvokeAsync(SaveAsync);
        }
    }

    private async Task ConfirmLeaveAsync(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context)
    {
        if (!_dirty)
        {
            return;
        }

        var leave = await DialogService.ShowMessageBoxAsync("Unsaved changes",
            "This workflow has changes that are not saved. Leave the editor and discard them?",
            yesText: "Discard", cancelText: "Stay");
        if (leave != true)
        {
            context.PreventNavigation();
        }
    }

    /// <summary>Called by gview-pipe-editor.js when a splitter is released.</summary>
    [JSInvokable]
    public async Task WidthChanged(string side, double width)
    {
        if (side == "palette")
        {
            _paletteWidth = width;
        }
        else
        {
            _panelWidth = width;
        }
        StateHasChanged();
        await SaveWidthsAsync();
    }

    private async Task ResetWidth(ResizeSide side)
    {
        if (side == ResizeSide.Palette)
        {
            _paletteWidth = DefaultPaletteWidth;
        }
        else
        {
            _panelWidth = DefaultPanelWidth;
        }
        await SaveWidthsAsync();
    }

    // the limits depend on the window, so the script knows them
    private async Task<double> ClampWidthAsync(ResizeSide side, double width)
        => await _editorModule!.InvokeAsync<double>("clamp", side == ResizeSide.Palette ? "palette" : "panel", width);

    private async Task SaveWidthsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", WidthsKey,
                string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{_paletteWidth:0};{_panelWidth:0}"));
        }
        catch (JSException) { }
    }

    /// <summary>
    /// Shows a back button; the host decides where to navigate. The argument is the id of the workflow's group
    /// (null without a known group), e.g. to return to the group's page.
    /// </summary>
    [Parameter] public EventCallback<string?> OnClose { get; set; }

    private IReadOnlyList<PipeWorkflowGroup> _groups = [];

    private PipeWorkflowGroup? KnownGroup => _workflow?.GroupId is { } id ? _groups.FirstOrDefault(g => g.Id == id) : null;

    private BlazorDiagram _diagram = default!;
    private PipeWorkflow? _workflow;
    private string? _loadedId;
    private bool _loading = true;
    private bool _dirty;
    private PipeNodeModel? _selected;
    private PipeExecution? _execution;
    private bool _running;
    private CancellationTokenSource? _runCts;
    private int _historyVersion;
    private bool _fitPending;

    protected override void OnInitialized()
    {
        var options = new BlazorDiagramOptions
        {
            AllowMultiSelection = true,
            GridSize = 20,
            Zoom = { Minimum = 0.3, Maximum = 2 },
            Links =
            {
                // SVG stroke attributes; CSS variables are not reliable there
                DefaultColor = "#9aa3b2",
                DefaultSelectedColor = "#3d6fd6",
                RequireTarget = true,
                EnableSnapping = true,
                SnappingRadius = 30,
                Factory = (_, source, target) => new LinkModel(new SinglePortAnchor((PortModel)source), target)
            }
        };

        _diagram = new BlazorDiagram(options);
        _diagram.RegisterComponent<PipeNodeModel, PipeNodeWidget>();
        _diagram.SelectionChanged += _ => InvokeAsync(SelectionChanged);
        _diagram.Nodes.Removed += node => InvokeAsync(() => NodeRemoved(node));
        _diagram.Links.Added += link =>
        {
            // a link drawn by hand gets its target only when it is dropped onto a port
            link.TargetChanged += (_, _, _) => InvokeAsync(MarkDirty);
            InvokeAsync(MarkDirty);
        };
        _diagram.Links.Removed += _ => InvokeAsync(MarkDirty);
        _diagram.ContainerChanged += () => InvokeAsync(ContainerChanged);
        _diagram.KeyDown += e => InvokeAsync(() => KeyDownAsync(e));
        _diagram.PointerDown += (model, _) => InvokeAsync(() => DragStart(model));
        _diagram.PointerMove += (_, e) => InvokeAsync(() => DragMove(e));
        _diagram.PointerUp += (_, e) => InvokeAsync(() => DragEnd(e));

        _runningThrottle = new PipeThrottle(TimeSpan.FromMilliseconds(200), () => InvokeAsync(RefreshRunningAsync));
        RunningExecutions.Changed += RunningChanged;
        // "since 0:42" counts up
        _runningClock = new Timer(_ => { if (_watched is not null || _othersRunning.Count > 0) _runningThrottle.Trigger(); }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    // ---- watching runs started elsewhere (cron, webhook, list, another editor) ----

    /// <summary>A run to watch, e.g. opened from "Running now" on the start page.</summary>
    [Parameter] public string? WatchExecutionId { get; set; }

    private PipeThrottle? _runningThrottle;
    private Timer? _runningClock;
    private string? _watchedId;
    private string? _watchParameterHandled;
    private PipeRunningExecutionInfo? _watched;
    private bool _watchedOutdated;
    private List<PipeRunningExecutionInfo> _othersRunning = [];

    /// <summary>Live output is shown for the editor's own run and for a watched run.</summary>
    private bool LiveActive => _running || _watched is { IsRunning: true };

    private void RunningChanged(string executionId) => _runningThrottle?.Trigger();

    private async Task WatchAsync(string executionId)
    {
        ClearExecution();
        _liveLines.Clear();
        // an own run ends watching another one
        _watchedId = null;
        _watched = null;
        _watchedId = executionId;
        await RefreshRunningAsync();
    }

    /// <summary>Banner of other runs of this workflow, and the state of the watched run.</summary>
    private async Task RefreshRunningAsync()
    {
        if (_workflow is null)
        {
            return;
        }

        _othersRunning = RunningExecutions.List()
            .Where(i => i.WorkflowId == _workflow.Id && i.IsRunning && i.ExecutionId != _watchedId && i.ExecutionId != _execution?.Id)
            .ToList();

        if (_watchedId is { } id)
        {
            var info = RunningExecutions.Find(id);
            if (info is { IsRunning: true })
            {
                _watched = info;
                var runs = RunningExecutions.GetNodeRuns(id);
                var models = _diagram.Nodes.OfType<PipeNodeModel>().ToList();
                foreach (var model in models)
                {
                    var run = runs.GetValueOrDefault(model.Node.Id);
                    if (!ReferenceEquals(run, model.Run) || run?.Status == PipeNodeRunStatus.Running)
                    {
                        model.Run = run;
                        model.Refresh();
                    }
                }
                _watchedOutdated = runs.Keys.Any(nodeId => models.All(m => m.Node.Id != nodeId));
                _liveLines.Clear();
                _liveLines.AddRange(RunningExecutions.GetLines(id));
            }
            else
            {
                // finished (or long gone): show its result like a run from the history
                _watchedId = null;
                _watched = null;
                var execution = RunningExecutions.GetFinished(id) ?? await ExecutionStore.GetAsync(_workflow.Id, id);
                if (execution is not null)
                {
                    ShowExecution(execution);
                }
                _historyVersion++;
            }
        }

        StateHasChanged();
    }

    private async Task StopWatchedAsync()
    {
        if (_watched is not { } watched)
        {
            return;
        }
        var confirmed = await DialogService.ShowMessageBoxAsync("Stop run", $"Stop this {watched.Mode.ToString().ToLowerInvariant()} run of '{watched.WorkflowName}'?", yesText: "Stop", cancelText: "Cancel");
        if (confirmed == true)
        {
            RunningExecutions.Cancel(watched.ExecutionId);
        }
    }

    static private string RunningFor(PipeRunningExecutionInfo info)
    {
        var duration = DateTimeOffset.UtcNow - info.StartedAt;
        return duration.TotalHours >= 1 ? duration.ToString(@"h\:mm\:ss") : duration.ToString(@"m\:ss");
    }

    static private Task Run(Action action)
    {
        action();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Shortcuts on the focused canvas (Delete is handled by the diagram itself). Only keys whose browser default
    /// does no harm: the server can't prevent defaults, and e.g. Ctrl+D would also open the bookmark dialog.
    /// </summary>
    private Task KeyDownAsync(Blazor.Diagrams.Core.Events.KeyboardEventArgs e)
    {
        if (!e.CtrlKey || e.AltKey)
        {
            return Task.CompletedTask;
        }

        return e.Key.ToLowerInvariant() switch
        {
            "c" => CopySelectionAsync(),
            "v" => PasteAsync(),
            "z" when e.ShiftKey => Run(Redo),
            "z" => Run(Undo),
            "y" => Run(Redo),
            _ => Task.CompletedTask
        };
    }

    /// <summary>
    /// Ports measure their position on first render, which can happen before the canvas knows its container.
    /// Re-render the nodes once it does, so ports get positions and links can be drawn.
    /// </summary>
    private void ContainerChanged()
    {
        foreach (var model in _diagram.Nodes.OfType<PipeNodeModel>())
        {
            model.RefreshAll();
        }

        if (_fitPending)
        {
            FitToNodes();
        }
    }

    /// <summary>
    /// Shows the whole workflow: zooms out (never in beyond 100 %) and pans it to the top left corner.
    /// Below 70 % the node names get unreadable, so a large workflow keeps that zoom and is scrolled instead.
    /// </summary>
    private void FitToNodes()
    {
        var models = _diagram.Nodes.OfType<PipeNodeModel>().ToList();
        if (models.Count == 0 || _diagram.Container is not { } container)
        {
            return;
        }

        const double margin = 60, MinFitZoom = 0.7;
        var minX = models.Min(m => m.Position.X);
        var minY = models.Min(m => m.Position.Y);
        var width = models.Max(m => m.Position.X + PipeNodeModel.Width) - minX;
        var height = models.Max(m => m.Position.Y + m.Height) - minY;
        var zoom = Math.Clamp(Math.Min((container.Width - 2 * margin) / width, (container.Height - 2 * margin) / height), MinFitZoom, 1);

        _fitPending = false;
        _diagram.SetZoom(zoom);
        _diagram.SetPan(margin - minX * zoom, margin - minY * zoom);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId != WorkflowId)
        {
            _loadedId = WorkflowId;
            _watchedId = null;
            _watched = null;
            await LoadAsync();
            await RefreshRunningAsync();
        }

        if (WatchExecutionId is { } watch && watch != _watchParameterHandled)
        {
            _watchParameterHandled = watch;
            await WatchAsync(watch);
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _workflow = await WorkflowStore.GetAsync(WorkflowId);
        _groups = await GroupStore.ListAsync();
        _selected = null;
        _execution = null;

        BuildDiagram();
        ResetHistory();

        _dirty = false;
        _loading = false;

        // the canvas may already exist (switching workflows); otherwise ContainerChanged does it
        _fitPending = true;
        FitToNodes();
    }

    /// <summary>Canvas models for the nodes and connections of <see cref="_workflow"/>.</summary>
    private void BuildDiagram()
    {
        _diagram.Links.Clear();
        _diagram.Nodes.Clear();

        if (_workflow is null)
        {
            return;
        }

        var models = _workflow.Nodes.Select(node => AddNodeModel(node, keepConnectedPorts: true)).ToDictionary(m => m.Node.Id);
        foreach (var connection in _workflow.Connections)
        {
            var source = models.GetValueOrDefault(connection.SourceNodeId)?.FindPort(connection.SourcePort, isInput: false);
            var target = models.GetValueOrDefault(connection.TargetNodeId)?.FindPort(connection.TargetPort, isInput: true);
            if (source is not null && target is not null)
            {
                _diagram.Links.Add(new LinkModel(source, target));
            }
        }
    }

    // ---- undo / redo ----
    // Snapshots of the whole workflow (JSON) after every change; undo puts the previous one back.
    // Simple and complete (nodes, links, positions, parameters, settings, pin data); fine for workflows of editor size.

    private const int MaxHistory = 100;

    private readonly LinkedList<string> _undo = new();
    private readonly Stack<string> _redo = new();
    private string? _current;
    private bool _restoring;

    private bool CanUndo => _undo.Count > 0;
    private bool CanRedo => _redo.Count > 0;

    private string Snapshot() => System.Text.Json.JsonSerializer.Serialize(BuildWorkflow(), PipeJson.Options);

    private void ResetHistory()
    {
        _undo.Clear();
        _redo.Clear();
        _current = _workflow is null ? null : Snapshot();
    }

    // typing raises a change every few hundred milliseconds; changes with the same key in a row become one step
    private static readonly TimeSpan MergeWindow = TimeSpan.FromSeconds(2);
    private string? _lastMergeKey;
    private DateTime _lastRecordAt;

    /// <summary>
    /// Records the state after a change; no entry if nothing in the workflow changed (e.g. a click).
    /// A change with the same <paramref name="mergeKey"/> as the one just before updates that step instead.
    /// </summary>
    private void RecordHistory(string? mergeKey = null)
    {
        if (_restoring || _workflow is null)
        {
            return;
        }

        var snapshot = Snapshot();
        if (snapshot == _current)
        {
            return;
        }

        var now = DateTime.UtcNow;
        var merge = mergeKey is not null && mergeKey == _lastMergeKey && now - _lastRecordAt < MergeWindow && _undo.Count > 0;
        _lastMergeKey = mergeKey;
        _lastRecordAt = now;

        if (_current is not null && !merge)
        {
            _undo.AddLast(_current);
            if (_undo.Count > MaxHistory)
            {
                _undo.RemoveFirst();
            }
        }
        _redo.Clear();
        _current = snapshot;
    }

    private void Undo()
    {
        if (_undo.Last is not { } previous || _current is null)
        {
            return;
        }
        _undo.RemoveLast();
        _redo.Push(_current);
        Restore(previous.Value);
    }

    private void Redo()
    {
        if (!_redo.TryPop(out var next) || _current is null)
        {
            return;
        }
        _undo.AddLast(_current);
        Restore(next);
    }

    /// <summary>Rebuilds the canvas from a snapshot; selection and the shown run stay where possible.</summary>
    private void Restore(string snapshot)
    {
        var selectedId = _selected?.Node.Id;
        _restoring = true;
        try
        {
            _workflow = PipeJson.Deserialize<PipeWorkflow>(snapshot)!;
            _selected = null;
            BuildDiagram();

            foreach (var model in _diagram.Nodes.OfType<PipeNodeModel>())
            {
                model.Run = _execution?.NodeRuns.GetValueOrDefault(model.Node.Id);
                if (model.Node.Id == selectedId)
                {
                    _diagram.SelectModel(model, unselectOthers: true);
                    _selected = model;
                }
            }
        }
        finally
        {
            _restoring = false;
        }

        _current = snapshot;
        _lastMergeKey = null;
        _dirty = true;
        StateHasChanged();
    }

    private PipeNodeModel AddNodeModel(PipeWorkflowNode node, bool keepConnectedPorts)
    {
        var model = new PipeNodeModel(node, Registry.Find(node.Type))
        {
            Pinned = _workflow?.PinData?.ContainsKey(node.Id) == true
        };
        SyncPorts(model, keepConnectedPorts);
        model.Moved += _ => InvokeAsync(() => NodeMoved(model));
        _diagram.Nodes.Add(model);
        return model;
    }

    /// <summary>
    /// Declared ports of the node type. While loading, ports referenced by stored connections are kept too,
    /// so connections of unknown node types (or removed ports) are not lost silently.
    /// </summary>
    private void SyncPorts(PipeNodeModel model, bool keepConnectedPorts)
    {
        var node = model.Node;
        var inputs = model.Descriptor is null ? [] : Registry.GetInputs(model.Descriptor, node.Parameters);
        var outputs = model.Descriptor is null ? [] : Registry.GetOutputs(model.Descriptor, node.Parameters, node.Settings);

        var keep = keepConnectedPorts && _workflow is not null
            ? _workflow.Connections.Where(c => c.SourceNodeId == node.Id).Select(c => (c.SourcePort, false))
                .Concat(_workflow.Connections.Where(c => c.TargetNodeId == node.Id).Select(c => (c.TargetPort, true)))
            : null;

        model.SyncPorts(_diagram, inputs, outputs, keep);
    }

    /// <summary>Writes positions and links back into the workflow.</summary>
    private PipeWorkflow BuildWorkflow()
    {
        var workflow = _workflow!;
        var models = _diagram.Nodes.OfType<PipeNodeModel>().ToList();

        foreach (var model in models)
        {
            model.Node.Position = new PipePosition { X = Math.Round(model.Position.X), Y = Math.Round(model.Position.Y) };
        }

        workflow.Nodes = models.Select(m => m.Node).ToList();
        workflow.Connections = _diagram.Links
            .Select(ToConnection)
            .OfType<PipeConnection>()
            .DistinctBy(c => (c.SourceNodeId, c.SourcePort, c.TargetNodeId, c.TargetPort))
            .ToList();

        // pin data of deleted nodes
        workflow.PinData?.Keys.Where(id => models.All(m => m.Node.Id != id)).ToList().ForEach(id => workflow.PinData.Remove(id));
        if (workflow.PinData?.Count == 0)
        {
            workflow.PinData = null;
        }

        return workflow;
    }

    static private PipeConnection? ToConnection(BaseLinkModel link)
    {
        if (link.Source.Model is not PipePortModel a || link.Target.Model is not PipePortModel b || a.IsInput == b.IsInput)
        {
            return null;
        }

        // links may have been drawn from the input side
        var (output, input) = a.IsInput ? (b, a) : (a, b);
        return new PipeConnection
        {
            SourceNodeId = ((PipeNodeModel)output.Parent).Node.Id,
            SourcePort = output.PortName,
            TargetNodeId = ((PipeNodeModel)input.Parent).Node.Id,
            TargetPort = input.PortName
        };
    }

    private void AddNode(PipeNodeDescriptor descriptor)
    {
        if (_workflow is null)
        {
            return;
        }

        var position = NextPosition();
        var node = new PipeWorkflowNode
        {
            Id = Guid.NewGuid().ToString("N"),
            Name = UniqueName(descriptor.Name),
            Type = descriptor.Id,
            TypeVersion = descriptor.Version,
            Parameters = descriptor.ParametersType is null
                ? new()
                : PipeJson.ToJsonObject(Activator.CreateInstance(descriptor.ParametersType)),
            Position = new PipePosition { X = position.X, Y = position.Y }
        };

        var model = AddNodeModel(node, keepConnectedPorts: false);
        _diagram.SelectModel(model, unselectOthers: true);
        MarkDirty();
    }

    /// <summary>Middle of the visible canvas, shifted a bit per node so new nodes don't stack exactly.</summary>
    private Point NextPosition()
    {
        var offset = _diagram.Nodes.Count % 5 * 30;
        if (_diagram.Container is { } container)
        {
            var center = _diagram.GetRelativePoint(container.Left + container.Width / 2, container.Top + container.Height / 2);
            return new Point(center.X - PipeNodeModel.Width / 2 + offset, center.Y - 40 + offset);
        }
        return new Point(100 + offset, 100 + offset);
    }

    private string UniqueName(string name)
    {
        var names = _diagram.Nodes.OfType<PipeNodeModel>().Select(m => m.Node.Name).ToHashSet();
        if (!names.Contains(name))
        {
            return name;
        }

        var i = 2;
        while (names.Contains($"{name} {i}"))
        {
            i++;
        }
        return $"{name} {i}";
    }

    private bool IsNameTaken(PipeNodeModel model, string name)
        => _diagram.Nodes.OfType<PipeNodeModel>().Any(m => m != model && m.Node.Name == name);

    private void SelectionChanged()
    {
        var selected = _diagram.GetSelectedModels().OfType<PipeNodeModel>().ToList();
        _selected = selected.Count == 1 ? selected[0] : null;
        StateHasChanged();
    }

    private void NodeRemoved(NodeModel node)
    {
        if (node == _selected)
        {
            _selected = null;
        }
        MarkDirty();
    }

    private void NodeChanged(bool portsMayHaveChanged)
    {
        if (_selected is not null)
        {
            if (portsMayHaveChanged)
            {
                SyncPorts(_selected, keepConnectedPorts: false);
            }
            _selected.Title = _selected.Node.Name;
            _selected.Refresh();
        }
        MarkDirty(portsMayHaveChanged ? null : $"node:{_selected?.Node.Id}");
    }

    private void NodeMoved(PipeNodeModel model) => MarkDirty();

    // ---- drop a node onto a link ----
    // Only with Shift held while dragging: the link closest to the mouse pointer is highlighted, and dropping
    // puts the node in between (source → node → target). Without Shift a hint says so, and nothing is computed,
    // so plain moving stays smooth and never rewires anything.

    private const double LinkHitPixels = 30;
    private const string DropLinkColor = "#e0902b";

    private PipeNodeModel? _dragged;
    private Point? _dragStart;
    private LinkModel? _dropLink;
    private bool _showDropHint;

    /// <summary>Sampled points of the links' paths, taken once per drag (the other links don't move meanwhile).</summary>
    private Dictionary<LinkModel, Point[]>? _linkSamples;

    private void DragStart(Model? model)
    {
        _dragged = model as PipeNodeModel;
        _dragStart = _dragged?.Position;
        _linkSamples = null;
    }

    private void DragMove(Blazor.Diagrams.Core.Events.PointerEventArgs e)
    {
        if (_dragged is null || e.Buttons == 0 || !HasMoved(_dragged))
        {
            return;
        }

        HighlightDropLink(e.ShiftKey ? FindDropLink(_dragged, e) : null);
        ShowDropHint(!e.ShiftKey && CanBeInserted(_dragged) && _diagram.Links.Count > 0);
    }

    private void DragEnd(Blazor.Diagrams.Core.Events.PointerEventArgs e)
    {
        var model = _dragged;
        var link = model is not null && e.ShiftKey && HasMoved(model) ? FindDropLink(model, e) : null;

        HighlightDropLink(null);
        ShowDropHint(false);
        _dragged = null;
        _dragStart = null;
        _linkSamples = null;

        if (model is not null && link is not null)
        {
            InsertIntoLink(model, link);
        }
    }

    private bool HasMoved(PipeNodeModel model)
        => _dragStart is { } start && (start.X != model.Position.X || start.Y != model.Position.Y);

    static private bool CanBeInserted(PipeNodeModel model)
        => model.InputPorts.Any() && OutputFor(model) is not null;

    private void ShowDropHint(bool show)
    {
        if (_showDropHint != show)
        {
            _showDropHint = show;
            StateHasChanged();
        }
    }

    /// <summary>The link nearest to the mouse pointer the node could be inserted into, or null.</summary>
    private LinkModel? FindDropLink(PipeNodeModel model, Blazor.Diagrams.Core.Events.PointerEventArgs e)
    {
        if (!CanBeInserted(model))
        {
            return null;
        }

        _linkSamples ??= _diagram.Links.OfType<LinkModel>()
            .Where(link => ToConnection(link) is not null
                           && (link.Source.Model as PipePortModel)?.Parent != model
                           && (link.Target.Model as PipePortModel)?.Parent != model)
            .ToDictionary(link => link, SamplePath);

        var pointer = _diagram.GetRelativeMousePoint(e.ClientX, e.ClientY);
        var maxDistance = LinkHitPixels / _diagram.Zoom;

        LinkModel? nearest = null;
        foreach (var (link, points) in _linkSamples)
        {
            foreach (var p in points)
            {
                var distance = Math.Sqrt((p.X - pointer.X) * (p.X - pointer.X) + (p.Y - pointer.Y) * (p.Y - pointer.Y));
                if (distance <= maxDistance)
                {
                    maxDistance = distance;
                    nearest = link;
                }
            }
        }
        return nearest;
    }

    static private PipePortModel? OutputFor(PipeNodeModel model)
        => model.FindPort(PipePorts.Main, isInput: false) ?? model.OutputPorts.FirstOrDefault();

    /// <summary>Points along the drawn path of the link, every few units.</summary>
    static private Point[] SamplePath(LinkModel link)
    {
        if (link.PathGeneratorResult?.FullPath is not { } path || path.Length <= 0)
        {
            return [];
        }

        var points = new List<Point>();
        for (double at = 0; at <= path.Length; at += 6)
        {
            var p = path.GetPointAtLength(at);
            points.Add(new Point(p.X, p.Y));
        }
        return points.ToArray();
    }

    private void HighlightDropLink(LinkModel? link)
    {
        if (link == _dropLink)
        {
            return;
        }

        if (_dropLink is not null)
        {
            _dropLink.Color = null;
            _dropLink.Width = 2;
            _dropLink.Refresh();
        }
        if (link is not null)
        {
            link.Color = DropLinkColor;
            link.Width = 4;
            link.Refresh();
        }
        _dropLink = link;
    }

    private void InsertIntoLink(PipeNodeModel model, LinkModel link)
    {
        var a = (PipePortModel)link.Source.Model!;
        var b = (PipePortModel)link.Target.Model!;
        var (source, target) = a.IsInput ? (b, a) : (a, b);

        _diagram.Links.Remove(link);
        _diagram.Links.Add(new LinkModel(source, model.InputPorts.First()));
        _diagram.Links.Add(new LinkModel(OutputFor(model)!, target));
    }

    private void DeleteSelected()
    {
        if (_selected is not null)
        {
            _diagram.Nodes.Remove(_selected);
        }
    }

    private void MarkDirty() => MarkDirty(null);

    /// <param name="mergeKey">Changes of the same thing in a row (typing into a node's fields) merge into one undo step.</param>
    private void MarkDirty(string? mergeKey)
    {
        if (!_loading && !_restoring)
        {
            _dirty = true;
            ScheduleHistory(mergeKey);
            StateHasChanged();
        }
    }

    private bool _historyScheduled;
    private string? _scheduledMergeKey;

    /// <summary>
    /// One user action can raise many changes (deleting a node first removes each of its links);
    /// the snapshot is taken once, after the action is done, so it is one undo step.
    /// </summary>
    private void ScheduleHistory(string? mergeKey)
    {
        if (_historyScheduled)
        {
            // different things changed in one action: don't merge it
            if (_scheduledMergeKey != mergeKey)
            {
                _scheduledMergeKey = null;
            }
            return;
        }
        _historyScheduled = true;
        _scheduledMergeKey = mergeKey;

        _ = InvokeAsync(async () =>
        {
            await Task.Yield();
            _historyScheduled = false;
            RecordHistory(_scheduledMergeKey);
            StateHasChanged();
        });
    }

    private void SetActive(bool active)
    {
        _workflow!.Active = active;
        MarkDirty();
    }

    private async Task SaveAsync()
    {
        try
        {
            var workflow = BuildWorkflow();
            await WorkflowStore.SaveAsync(workflow);
            var problems = await TriggerManager.ActivateAsync(workflow);
            _dirty = false;

            if (problems.Count > 0)
            {
                Snackbar.Add($"Saved, but some triggers are not armed: {string.Join("; ", problems)}", Severity.Warning,
                    options => options.RequireInteraction = true);
            }
            else
            {
                Snackbar.Add(workflow.Active ? "Saved, triggers armed" : "Saved", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
    }

    /// <param name="targetNodeId">"Run to here": only this node and the nodes it depends on.</param>
    private async Task RunAsync(string? targetNodeId = null)
    {
        // the engine gets a snapshot, so editing during the run can't interfere
        var workflow = PipeJson.Clone(BuildWorkflow());
        ClearExecution();
        _liveLines.Clear();

        _running = true;
        _runCts = new CancellationTokenSource();

        try
        {
            var request = new PipeExecutionRequest { Observer = new EditorObserver(this), TargetNodeId = targetNodeId };
            var execution = await Runner.RunAsync(workflow, request, _runCts.Token);
            if (execution is null)
            {
                Snackbar.Add("The workflow is already running (max concurrent runs reached)", Severity.Warning);
                return;
            }

            ShowExecution(execution);
            Snackbar.Add(execution.Status == PipeExecutionStatus.Success ? "Run finished" : $"Run {execution.Status}: {execution.Error}",
                execution.Status == PipeExecutionStatus.Success ? Severity.Success : Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Run failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _running = false;
            _runCts.Dispose();
            _runCts = null;
            _historyVersion++;
        }
    }

    private void StopRun() => _runCts?.Cancel();

    private void SetPinData(Dictionary<string, List<PipeItem>>? outputs)
    {
        if (_workflow is null || _selected is null)
        {
            return;
        }

        var nodeId = _selected.Node.Id;
        if (outputs is null)
        {
            _workflow.PinData?.Remove(nodeId);
        }
        else
        {
            (_workflow.PinData ??= new())[nodeId] = outputs;
        }

        _selected.Pinned = outputs is not null;
        _selected.Refresh();
        MarkDirty();
    }

    // ---- copy, paste, duplicate ----

    private List<PipeNodeModel> SelectedNodes() => _diagram.GetSelectedModels().OfType<PipeNodeModel>().ToList();

    /// <summary>The selected nodes (with their current positions) and the connections among them.</summary>
    private PipeClipboardContent? CopySelection()
    {
        var models = SelectedNodes();
        if (models.Count == 0)
        {
            return null;
        }

        var ids = models.Select(m => m.Node.Id).ToHashSet();
        var nodes = models.Select(m =>
        {
            var node = PipeJson.Clone(m.Node);
            node.Position = new PipePosition { X = Math.Round(m.Position.X), Y = Math.Round(m.Position.Y) };
            return node;
        }).ToList();
        var connections = _diagram.Links.Select(ToConnection).OfType<PipeConnection>()
            .Where(c => ids.Contains(c.SourceNodeId) && ids.Contains(c.TargetNodeId))
            .ToList();

        return new PipeClipboardContent { Nodes = nodes, Connections = connections };
    }

    private async Task CopySelectionAsync()
    {
        if (CopySelection() is { } content)
        {
            await Clipboard.CopyAsync(content);
            Snackbar.Add(content.Nodes.Count == 1 ? $"Copied '{content.Nodes[0].Name}'" : $"Copied {content.Nodes.Count} nodes", Severity.Info);
        }
    }

    private Task DuplicateSelectionAsync()
    {
        if (CopySelection() is { } content)
        {
            InsertNodes(content, offset: new Point(40, 40));
        }
        return Task.CompletedTask;
    }

    private async Task PasteAsync()
    {
        if (_workflow is null)
        {
            return;
        }

        if (await Clipboard.PasteAsync() is not { } content)
        {
            Snackbar.Add("The clipboard contains no nodes", Severity.Info);
            return;
        }

        // the copied group lands in the visible area
        var target = NextPosition();
        InsertNodes(content, new Point(target.X - content.Nodes.Min(n => n.Position.X), target.Y - content.Nodes.Min(n => n.Position.Y)));
    }

    /// <summary>Adds copies with new ids and unique names, keeps the connections among them and selects them.</summary>
    private void InsertNodes(PipeClipboardContent content, Point offset)
    {
        var ids = new Dictionary<string, string>();
        var models = new List<PipeNodeModel>();

        foreach (var original in content.Nodes)
        {
            var node = PipeJson.Clone(original);
            node.Id = Guid.NewGuid().ToString("N");
            node.Name = UniqueName(original.Name);
            node.Position = new PipePosition { X = original.Position.X + offset.X, Y = original.Position.Y + offset.Y };
            ids[original.Id] = node.Id;
            models.Add(AddNodeModel(node, keepConnectedPorts: false));
        }

        foreach (var connection in content.Connections)
        {
            var source = models.FirstOrDefault(m => m.Node.Id == ids.GetValueOrDefault(connection.SourceNodeId))?.FindPort(connection.SourcePort, isInput: false);
            var target = models.FirstOrDefault(m => m.Node.Id == ids.GetValueOrDefault(connection.TargetNodeId))?.FindPort(connection.TargetPort, isInput: true);
            if (source is not null && target is not null)
            {
                _diagram.Links.Add(new LinkModel(source, target));
            }
        }

        _diagram.UnselectAll();
        foreach (var model in models)
        {
            _diagram.SelectModel(model, unselectOthers: false);
        }
        MarkDirty();
    }

    private void ShowExecution(PipeExecution execution)
    {
        _execution = execution;
        foreach (var model in _diagram.Nodes.OfType<PipeNodeModel>())
        {
            model.Run = execution.NodeRuns.GetValueOrDefault(model.Node.Id);
            model.Refresh();
        }
        StateHasChanged();
    }

    private void ClearExecution()
    {
        _execution = null;
        foreach (var model in _diagram.Nodes.OfType<PipeNodeModel>())
        {
            model.Run = null;
            model.Refresh();
        }
    }

    // ---- live output ----

    private const int MaxLiveLines = 2000;
    private readonly List<PipeLiveLine> _liveLines = new();
    private bool _liveRenderPending;

    /// <summary>Collects a line; the panel is rendered at most every 200 ms, however fast the lines come.</summary>
    private Task LiveLineAsync(PipeNodeRun run, PipeLogEntry entry) => InvokeAsync(async () =>
    {
        _liveLines.Add(new PipeLiveLine(run.NodeId, run.NodeName, entry));
        if (_liveLines.Count > MaxLiveLines)
        {
            _liveLines.RemoveRange(0, _liveLines.Count - MaxLiveLines);
        }

        if (_liveRenderPending)
        {
            return;
        }
        _liveRenderPending = true;
        await Task.Delay(200);
        _liveRenderPending = false;
        StateHasChanged();
    });

    private IReadOnlyList<PipeLiveLine> LiveLinesOf(string nodeId) => _liveLines.Where(l => l.NodeId == nodeId).ToList();

    private Task NodeRunChangedAsync(PipeNodeRun run) => InvokeAsync(() =>
    {
        if (_diagram.Nodes.OfType<PipeNodeModel>().FirstOrDefault(m => m.Node.Id == run.NodeId) is { } model)
        {
            model.Run = run;
            model.Refresh();
        }
        if (_selected?.Node.Id == run.NodeId)
        {
            StateHasChanged();
        }
    });

    static private Color StatusColor(PipeExecutionStatus status) => status switch
    {
        PipeExecutionStatus.Success => Color.Success,
        PipeExecutionStatus.Error => Color.Error,
        PipeExecutionStatus.Running => Color.Info,
        _ => Color.Default
    };

    public async ValueTask DisposeAsync()
    {
        RunningExecutions.Changed -= RunningChanged;
        _runningClock?.Dispose();
        _runningThrottle?.Dispose();
        _runCts?.Cancel();

        try
        {
            if (_editorScript is not null)
            {
                await _editorScript.InvokeVoidAsync("dispose");
                await _editorScript.DisposeAsync();
            }
            if (_editorModule is not null)
            {
                await _editorModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }

    /// <summary>Pushes live node states of the editor's own run onto the canvas.</summary>
    private sealed class EditorObserver : IPipeExecutionObserver
    {
        private readonly PipeEditor _editor;

        public EditorObserver(PipeEditor editor)
        {
            _editor = editor;
        }

        public Task OnExecutionStartedAsync(PipeExecution execution)
            => _editor.InvokeAsync(() =>
            {
                _editor._execution = execution;
                _editor.StateHasChanged();
            });

        public Task OnNodeStartedAsync(PipeExecution execution, PipeNodeRun run) => _editor.NodeRunChangedAsync(run);

        public Task OnNodeFinishedAsync(PipeExecution execution, PipeNodeRun run) => _editor.NodeRunChangedAsync(run);

        public Task OnNodeLogAsync(PipeExecution execution, PipeNodeRun run, PipeLogEntry entry) => _editor.LiveLineAsync(run, entry);
    }
}
