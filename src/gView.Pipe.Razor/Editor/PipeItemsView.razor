@using gView.Pipe.Abstraction.Data
@using Microsoft.JSInterop
@inject IJSRuntime JS

@*
    Items per port: one tab per port. Shown as a table (one column per field), as indented JSON, or as text: every field a heading, its value a paragraph
    with line breaks kept (readable output of scripts, HTTP bodies, …). The choice is kept in the browser.
*@

@if (Items is null)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        @(Counts.Count > 0
            ? $"Item data was not saved for this execution ({string.Join(", ", Counts.Select(c => $"{c.Key}: {c.Value}"))})."
            : "No data.")
    </MudText>
}
else if (Items.Count == 0 || Items.All(p => p.Value.Count == 0) && Items.Count == 1)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">@EmptyText</MudText>
}
else
{
    <div class="gview-pipe-items-mode">
        <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
            <MudButton Variant="@(_mode == TableMode ? Variant.Filled : Variant.Outlined)" OnClick="() => SetModeAsync(TableMode)">Table</MudButton>
            <MudButton Variant="@(_mode == JsonMode ? Variant.Filled : Variant.Outlined)" OnClick="() => SetModeAsync(JsonMode)">JSON</MudButton>
            <MudButton Variant="@(_mode == TextMode ? Variant.Filled : Variant.Outlined)" OnClick="() => SetModeAsync(TextMode)">Text</MudButton>
        </MudButtonGroup>
    </div>
    <MudTabs Elevation="0" Rounded="false" Class="gview-pipe-output-tabs" MinimumTabWidth="60px">
        @foreach (var (port, items) in Items)
        {
            <MudTabPanel Text="@($"{port} ({items.Count})")">
                @if (items.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No items.</MudText>
                }
                @if (_mode == TableMode && items.Count > 0)
                {
                    var shown = items.Take(MaxItems).ToList();
                    var columns = shown.SelectMany(i => i.Json.Select(p => p.Key)).Distinct().ToList();
                    var files = shown.Any(i => i.Binary.Count > 0);
                    <div class="gview-pipe-items-table">
                        <table>
                            <thead>
                                <tr>
                                    <th>#</th>
                                    @foreach (var column in columns)
                                    {
                                        <th>@column</th>
                                    }
                                    @if (files)
                                    {
                                        <th>Attachments</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (item, index) in shown.Select((item, index) => (item, index)))
                                {
                                    <tr>
                                        <td>@index</td>
                                        @foreach (var column in columns)
                                        {
                                            <td>@(item.Json.TryGetPropertyValue(column, out var cell) ? CellText(cell) : "")</td>
                                        }
                                        @if (files)
                                        {
                                            <td>
                                                @foreach (var (name, binary) in item.Binary)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.AttachFile">@name: @binary.FileName</MudChip>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @foreach (var (item, index) in items.Take(_mode == TableMode ? 0 : MaxItems).Select((item, index) => (item, index)))
                {
                    <div class="gview-pipe-item">
                        <div class="gview-pipe-item-index">#@index</div>
                        @if (_mode == TextMode)
                        {
                            <PipeItemText Value="item.Json" />
                        }
                        else if (OnSelectPath.HasDelegate)
                        {
                            <PipeJsonTree Value="item.Json" OnSelectPath="OnSelectPath" />
                        }
                        else
                        {
                            <pre class="gview-pipe-code">@PipeJsonText.ToIndentedJson(item.Json)</pre>
                        }
                        @foreach (var (name, binary) in item.Binary)
                        {
                            <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.AttachFile">@name: @binary.FileName (@binary.Length bytes)</MudChip>
                        }
                    </div>
                }
                @if (items.Count > MaxItems)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">… @(items.Count - MaxItems) more items</MudText>
                }
            </MudTabPanel>
        }
    </MudTabs>
}

@code {
    private const int MaxItems = 50;
    private const string ModeKey = "gview-pipe.items.mode";

    /// <summary>Items per port; null when the execution did not store item data.</summary>
    [Parameter] public Dictionary<string, List<PipeItem>>? Items { get; set; }

    [Parameter] public Dictionary<string, int> Counts { get; set; } = new();

    [Parameter] public string EmptyText { get; set; } = "No items.";

    /// <summary>When set, properties are clickable (JSON view) and report their path (e.g. <c>$json.a.b</c>).</summary>
    [Parameter] public EventCallback<string> OnSelectPath { get; set; }

    private const string TableMode = "table", JsonMode = "json", TextMode = "text";

    /// <summary>The view until the user picks one (kept in the browser): <c>json</c>, <c>table</c> or <c>text</c>.</summary>
    [Parameter] public string DefaultMode { get; set; } = JsonMode;

    private string? _mode;

    protected override void OnParametersSet() => _mode ??= DefaultMode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", ModeKey);
            if (stored is TableMode or JsonMode or TextMode && stored != _mode)
            {
                _mode = stored;
                StateHasChanged();
            }
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException) { }
    }

    private async Task SetModeAsync(string mode)
    {
        _mode = mode;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ModeKey, mode);
        }
        catch (JSException) { }
    }

    static private string CellText(System.Text.Json.Nodes.JsonNode? value)
        => value is System.Text.Json.Nodes.JsonValue v && v.GetValueKind() == System.Text.Json.JsonValueKind.String
            ? v.GetValue<string>()
            : value?.ToJsonString() ?? "null";
}
