@using System.Text.Json.Nodes
@using gView.Pipe.Abstraction.Data
@using gView.Pipe.Abstraction.Nodes
@inject IPipeNodeRegistry Registry
@inject PipeEditorClipboard Clipboard
@inject ISnackbar Snackbar

<div class="gview-pipe-panel-header" style="--gview-pipe-accent:@PipeNodeVisuals.Accent(Model.Descriptor)">
    <MudIcon Icon="@PipeNodeVisuals.Icon(Model.Descriptor)" />
    <div class="gview-pipe-panel-titles">
        <MudText Typo="Typo.subtitle1">@Model.Node.Name</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@(Model.Descriptor?.Name ?? $"Unknown node type {Model.Node.Type}")</MudText>
    </div>
    <MudSpacer />
    <MudTooltip Text="Run to here: execute this node and the nodes it depends on">
        <MudIconButton Icon="@Icons.Material.Filled.PlayCircleOutline" Size="Size.Small" aria-label="Run to here" Disabled="Running" OnClick="() => OnRunToHere.InvokeAsync()" />
    </MudTooltip>
    <MudTooltip Text="Duplicate">
        <MudIconButton Icon="@Icons.Material.Filled.ControlPointDuplicate" Size="Size.Small" aria-label="Duplicate node" OnClick="() => OnDuplicate.InvokeAsync()" />
    </MudTooltip>
    <MudTooltip Text="Copy (Ctrl+C)">
        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" aria-label="Copy node" OnClick="() => OnCopy.InvokeAsync()" />
    </MudTooltip>
    <MudTooltip Text="Delete (Del)">
        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="Delete node" OnClick="() => OnDelete.InvokeAsync()" />
    </MudTooltip>
</div>

@if (Model.Descriptor?.Description is { } description)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary px-4 pb-2">@description</MudText>
}
@if (Model.Descriptor is null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mx-4 mb-2">The plugin providing this node is not installed. The node is kept but can't run.</MudAlert>
}
@foreach (var hint in _hints)
{
    <MudAlert Severity="@(hint.Level == PipeNodeHintLevel.Warning ? Severity.Warning : Severity.Info)" Dense="true" Class="mx-4 mb-2">@hint.Message</MudAlert>
}

<MudTabs Elevation="0" Rounded="false" @bind-ActivePanelIndex="_tab" Class="gview-pipe-panel-tabs" MinimumTabWidth="80px">
    <MudTabPanel Text="Parameters">
        <PipeParameterForm ParametersType="Model.Descriptor?.ParametersType"
                           Parameters="Model.Node.Parameters"
                           ShowRawWithoutType="@(Model.Descriptor is null)"
                           OnExpressionFieldFocused="f => _activeField = f"
                           OptionsProvider="@(Model.Descriptor?.HasParameterOptions == true ? LoadOptionsAsync : null)"
                           OnChanged="ParametersChangedAsync" />
    </MudTabPanel>

    <MudTabPanel Text="Settings">
        <MudStack Spacing="3">
            <MudTextField T="string" Immediate="true" DebounceInterval="300" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense"
                          HelperText="Unique in the workflow; used by $node[&quot;Name&quot;] expressions"
                          Error="@(_nameError is not null)" ErrorText="@_nameError"
                          Value="@Model.Node.Name" ValueChanged="RenameAsync" />
            <MudTextField T="string" Immediate="true" DebounceInterval="300" Label="Notes" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2"
                          Value="@Model.Node.Notes" ValueChanged="v => ChangeAsync(() => Model.Node.Notes = v)" />
            <MudSwitch T="bool" Label="Disabled (passes items through)" Color="Color.Primary"
                       Value="Model.Node.Disabled" ValueChanged="v => ChangeAsync(() => Model.Node.Disabled = v)" />
            <MudSwitch T="bool" Label="Always execute, even without input items" Color="Color.Primary"
                       Value="Settings.AlwaysExecute" ValueChanged="v => ChangeAsync(() => Settings.AlwaysExecute = v)" />
            <MudSelect T="PipeNodeErrorMode" Label="On error" Variant="Variant.Outlined" Dense="true"
                       Value="Settings.OnError" ValueChanged="v => ChangeAsync(() => Settings.OnError = v, portsMayHaveChanged: true)">
                <MudSelectItem Value="PipeNodeErrorMode.Stop">Stop the execution</MudSelectItem>
                <MudSelectItem Value="PipeNodeErrorMode.Continue">Continue with the input items</MudSelectItem>
                <MudSelectItem Value="PipeNodeErrorMode.ErrorOutput">Route items to an error output</MudSelectItem>
            </MudSelect>
            <MudStack Row="true" Spacing="2">
                <MudNumericField T="int" Immediate="true" DebounceInterval="300" Label="Retries" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="20"
                                 Value="Settings.RetryCount" ValueChanged="v => ChangeAsync(() => Settings.RetryCount = v)" />
                <MudNumericField T="int" Immediate="true" DebounceInterval="300" Label="Retry delay (ms)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Step="500"
                                 Value="Settings.RetryDelayMs" ValueChanged="v => ChangeAsync(() => Settings.RetryDelayMs = v)" />
            </MudStack>
            <MudNumericField T="int" Immediate="true" DebounceInterval="300" Label="Timeout (seconds, 0 = none)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0"
                             Value="Settings.TimeoutSeconds" ValueChanged="v => ChangeAsync(() => Settings.TimeoutSeconds = v)" />
        </MudStack>
    </MudTabPanel>

    <MudTabPanel Text="Run" BadgeData="@OutputBadge" BadgeColor="@(Model.Run?.Status == PipeNodeRunStatus.Error ? Color.Error : Color.Primary)">
        @if (PinnedOutputs is not null)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Icon="@Icons.Material.Filled.PushPin" Class="mb-3">
                Output is pinned: manual runs use the data below instead of executing the node. Triggered runs ignore it.
            </MudAlert>
            <PipeRawJsonField Label="Pinned output (items per port)" Value="_pinJson" ValueChanged="PinEditedAsync"
                              HelperText="@(_pinError ?? "{ \"port\": [ { …item… } ] }")" />
            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-3">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Clear" OnClick="() => OnPinChanged.InvokeAsync(null)">Unpin</MudButton>
            </MudStack>
        }
        else if (CanPin)
        {
            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-1">
                <MudTooltip Text="Keep this output: manual runs use it instead of executing the node">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PushPin" OnClick="PinRunOutputAsync">Pin output</MudButton>
                </MudTooltip>
            </MudStack>
        }
        @if (LiveLines is not null && Model.Run?.Status == PipeNodeRunStatus.Running)
        {
            <PipeLiveOutput Lines="LiveLines" Running="true" />
        }
        <PipeNodeRunView Run="Model.Run" OnSelectInputPath="InsertExpressionAsync" />
    </MudTabPanel>
</MudTabs>

@code {
    [Parameter, EditorRequired] public PipeNodeModel Model { get; set; } = default!;

    /// <summary>Called after a change; the argument tells whether the ports may have changed.</summary>
    [Parameter] public EventCallback<bool> OnChanged { get; set; }

    [Parameter] public EventCallback OnDelete { get; set; }

    [Parameter] public Func<PipeNodeModel, string, bool> IsNameTaken { get; set; } = (_, _) => false;

    [Parameter] public EventCallback OnRunToHere { get; set; }

    [Parameter] public EventCallback OnDuplicate { get; set; }

    [Parameter] public EventCallback OnCopy { get; set; }

    /// <summary>A run of the workflow is in progress.</summary>
    [Parameter] public bool Running { get; set; }

    /// <summary>Log lines of this node while a run is in progress; null when there is no run.</summary>
    [Parameter] public IReadOnlyList<PipeLiveLine>? LiveLines { get; set; }

    /// <summary>Pin data of the node (items per output port), null when not pinned.</summary>
    [Parameter] public Dictionary<string, List<PipeItem>>? PinnedOutputs { get; set; }

    /// <summary>New pin data of the node; null unpins it.</summary>
    [Parameter] public EventCallback<Dictionary<string, List<PipeItem>>?> OnPinChanged { get; set; }

    private int _tab;
    private string? _nameError;
    private IReadOnlyList<PipeNodeHint> _hints = [];
    private PipeExpressionTarget? _activeField;
    private Dictionary<string, List<PipeItem>>? _pinSource;
    private JsonObject? _pinJson;
    private string? _pinError;

    protected override void OnParametersSet()
    {
        UpdateHints();

        if (!ReferenceEquals(PinnedOutputs, _pinSource))
        {
            _pinSource = PinnedOutputs;
            _pinJson = PinnedOutputs is null ? null : PinToJson(PinnedOutputs);
            _pinError = null;
        }

        // the node just started: show its live output
        var running = LiveLines is not null && Model.Run?.Status == PipeNodeRunStatus.Running;
        if (running && !_wasRunning)
        {
            _tab = RunTab;
        }
        _wasRunning = running;
    }

    private const int RunTab = 2;
    private bool _wasRunning;

    /// <summary>Only data of a successful run can be pinned; binary content belongs to its execution and is dropped.</summary>
    private bool CanPin => Model.Run is { Status: PipeNodeRunStatus.Success, Pinned: false, Outputs: not null };

    private async Task PinRunOutputAsync()
    {
        var outputs = Model.Run!.Outputs!.ToDictionary(
            p => p.Key,
            p => p.Value.Select(i => new PipeItem((JsonObject)i.Json.DeepClone())).ToList());
        await OnPinChanged.InvokeAsync(outputs);
    }

    static private JsonObject PinToJson(Dictionary<string, List<PipeItem>> pinned)
    {
        var json = new JsonObject();
        foreach (var (port, items) in pinned)
        {
            json[port] = new JsonArray(items.Select(i => (JsonNode)i.Json.DeepClone()).ToArray());
        }
        return json;
    }

    private async Task PinEditedAsync(JsonNode? value)
    {
        if (value is not JsonObject ports
            || ports.Any(p => p.Value is not JsonArray items || items.Any(i => i is not JsonObject)))
        {
            _pinError = "Expected an object with an array of item objects per port, e.g. { \"main\": [ { \"a\": 1 } ] }";
            return;
        }

        _pinError = null;
        var pinned = ports.ToDictionary(
            p => p.Key,
            p => p.Value!.AsArray().Select(i => new PipeItem((JsonObject)i!.DeepClone())).ToList());
        // keep both references, so the JSON field doesn't reformat what the user is typing
        _pinSource = pinned;
        _pinJson = ports;
        await OnPinChanged.InvokeAsync(pinned);
    }

    /// <summary>Appends <c>{{ path }}</c> to the parameter edited last, or copies it when there is none.</summary>
    private async Task InsertExpressionAsync(string path)
    {
        var expression = $"{{{{ {path} }}}}";

        if (_activeField is null)
        {
            var copied = await Clipboard.TryWriteTextAsync(expression);
            Snackbar.Add(copied ? $"Copied {expression}; click into a parameter first to insert it directly" : expression, Severity.Info);
            return;
        }

        var parameters = Model.Node.Parameters;
        var key = _activeField.Field.Key;
        switch (_activeField)
        {
            case { Key: { } entry } when parameters[key] is JsonObject entries:
                entries[entry] = JsonValue.Create(PipeJsonText.ToText(entries[entry]) + expression);
                break;
            case { Index: { } index } when parameters[key] is JsonArray list && index < list.Count:
                list[index] = JsonValue.Create(PipeJsonText.ToText(list[index]) + expression);
                break;
            default:
                parameters[key] = JsonValue.Create(PipeJsonText.ToText(parameters[key]) + expression);
                break;
        }

        _tab = 0;
        var label = _activeField.Key is { } name ? $"{_activeField.Field.Label} › {name}" : _activeField.Field.Label;
        Snackbar.Add($"Inserted {expression} into '{label}'", Severity.Success);
        await ParametersChangedAsync();
    }

    private void UpdateHints()
        => _hints = Model.Descriptor is { } descriptor ? Registry.GetHints(descriptor, Model.Node.Parameters) : [];

    private async Task ParametersChangedAsync()
    {
        UpdateHints();
        await OnChanged.InvokeAsync(Model.Descriptor?.HasDynamicPorts == true);
    }

    private PipeNodeSettings Settings => Model.Node.Settings;

    private async Task<IReadOnlyList<PipeParameterOption>> LoadOptionsAsync(string parameter, bool refresh)
    {
        try
        {
            return await Registry.GetParameterOptionsAsync(Model.Descriptor!, parameter, Model.Node.Parameters, refresh);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Can't load the choices for '{parameter}': {ex.Message}", Severity.Warning);
            return [];
        }
    }

    private object? OutputBadge => Model.Run switch
    {
        null => null,
        { Status: PipeNodeRunStatus.Error } => "!",
        var run => run.OutputCounts.Values.Sum()
    };

    private async Task ChangeAsync(Action change, bool portsMayHaveChanged = false)
    {
        change();
        await OnChanged.InvokeAsync(portsMayHaveChanged);
    }

    private async Task RenameAsync(string? name)
    {
        name = name?.Trim() ?? "";
        _nameError = name.Length == 0 ? "A name is required"
            : IsNameTaken(Model, name) ? "Another node already has this name"
            : null;

        if (_nameError is null)
        {
            await ChangeAsync(() => Model.Node.Name = name);
        }
    }
}
