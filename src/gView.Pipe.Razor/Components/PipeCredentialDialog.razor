@using System.Text.Json.Nodes
@using gView.Pipe.Abstraction.Credentials
@inject IPipeCredentialStore CredentialStore
@inject IPipeCredentialTypeRegistry CredentialTypes

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudStack Spacing="3">
                <MudTextField T="string" @bind-Value="_name" Label="Name *" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudSelect T="Guid" Label="Type *" Variant="Variant.Outlined" Dense="true"
                           Disabled="_existing is not null" Value="_typeId" ValueChanged="TypeChanged">
                    @foreach (var type in CredentialTypes.CredentialTypes.OrderBy(t => t.Name))
                    {
                        <MudSelectItem Value="type.Id">@type.Name</MudSelectItem>
                    }
                </MudSelect>
                @if (_type?.Description is { } description)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@description</MudText>
                }
                @if (_type is not null)
                {
                    <PipeParameterForm @key="_type" ParametersType="_type.DataType" Parameters="_data" SecretsArePlaceholders="@(_existing is not null)" />
                }
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_loading">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>Null creates a new credential.</summary>
    [Parameter] public string? CredentialId { get; set; }

    private bool _loading = true;
    private PipeCredential? _existing;
    private string? _name;
    private Guid _typeId;
    private PipeCredentialTypeDescriptor? _type;
    private JsonObject _data = new();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (CredentialId is not null)
        {
            _existing = await CredentialStore.GetAsync(CredentialId);
        }

        if (_existing is not null)
        {
            _name = _existing.Name;
            _typeId = _existing.TypeId;
            _type = CredentialTypes.Find(_typeId);
            // secrets are not sent to the browser; an empty secret field means "unchanged"
            _data = (JsonObject)_existing.Data.DeepClone();
            foreach (var field in SecretFields())
            {
                _data.Remove(field.Key);
            }
        }
        else if (CredentialTypes.CredentialTypes.OrderBy(t => t.Name).FirstOrDefault() is { } first)
        {
            TypeChanged(first.Id);
        }

        _loading = false;
    }

    private void TypeChanged(Guid typeId)
    {
        _typeId = typeId;
        _type = CredentialTypes.Find(typeId);
        _data = _type is null ? new() : PipeJson.ToJsonObject(Activator.CreateInstance(_type.DataType));
    }

    private IEnumerable<PipeParameterField> SecretFields()
        => _type is null ? [] : PipeParameterFields.For(_type.DataType).Where(f => f.Secret);

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name) || _type is null)
        {
            _error = "Name and type are required";
            return;
        }

        var data = (JsonObject)_data.DeepClone();
        if (_existing is not null)
        {
            foreach (var field in SecretFields())
            {
                if (string.IsNullOrEmpty(PipeJsonText.ToText(data[field.Key])) && _existing.Data[field.Key] is { } stored)
                {
                    data[field.Key] = stored.DeepClone();
                }
            }
        }

        var missing = PipeParameterFields.For(_type.DataType)
            .Where(f => f.Required && string.IsNullOrEmpty(PipeJsonText.ToText(data[f.Key])))
            .Select(f => f.Label)
            .ToList();
        if (missing.Count > 0)
        {
            _error = $"Required: {string.Join(", ", missing)}";
            return;
        }

        await CredentialStore.SaveAsync(new PipeCredential
        {
            Id = _existing?.Id ?? "",
            Name = _name.Trim(),
            TypeId = _type.Id,
            Data = data
        });

        Dialog.Close(DialogResult.Ok(true));
    }
}
