@using gView.Pipe.Abstraction.Secrets
@inject IPipeSecretResolver Resolver

@* Picks a secret of a configured source instead of typing the value (ADR 0033). The value is never shown. *@

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudSelect T="string" Label="Source" Variant="Variant.Outlined" Dense="true" @bind-Value="_source">
                @foreach (var source in Resolver.Sources)
                {
                    <MudSelectItem Value="source">@source</MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_name"
                          Placeholder="e.g. db-password or db-password@3"
                          HelperText="Name of the secret in the source; for sources with versions @@version is optional." />
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="CheckAsync" Disabled="@(!CanUse || _checking)">Check</MudButton>
                @if (_result is { } result)
                {
                    <MudText Typo="Typo.body2" Color="@(result.Found ? Color.Success : Color.Error)">@(result.Found ? "Found" : result.Error)</MudText>
                }
            </MudStack>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton OnClick="() => Dialog.Close(DialogResult.Ok(string.Empty))">Use a plain value</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanUse)" OnClick="UseAsync">Use</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>The current value of the field; a reference fills the dialog.</summary>
    [Parameter] public string? Value { get; set; }

    private string? _source;
    private string? _name;
    private bool _checking;
    private PipeSecretCheck? _result;

    private bool CanUse => !string.IsNullOrWhiteSpace(_source) && !string.IsNullOrWhiteSpace(_name);

    protected override void OnInitialized()
    {
        if (PipeSecretReference.TryParse(Value, out var reference))
        {
            _source = reference.Source;
            _name = reference.Name;
        }
        else
        {
            _source = Resolver.Sources.FirstOrDefault();
        }
    }

    private async Task CheckAsync()
    {
        _checking = true;
        try
        {
            _result = await Resolver.CheckAsync(new PipeSecretReference(_source!.Trim(), _name!.Trim()));
        }
        finally
        {
            _checking = false;
        }
    }

    private Task UseAsync()
    {
        Dialog.Close(DialogResult.Ok(new PipeSecretReference(_source!.Trim(), _name!.Trim()).ToString()));
        return Task.CompletedTask;
    }
}
