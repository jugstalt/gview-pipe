@inject IPipeAuthorization Authorization
@inject gView.Pipe.Abstraction.Audit.IPipeAuditLog AuditLog
@inject IPipeWorkflowGroupStore GroupStore
@inject IPipeEnvironments Environments
@inject IPipeErrorWorkflows ErrorWorkflows
@inject IPipeWorkflowStore WorkflowStore

@* Creates or edits a workflow group. Closes with the saved group. *@

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField T="string" @bind-Value="_group.Name" Label="Name *" Variant="Variant.Outlined" Margin="Margin.Dense" AutoFocus="true" />
            <MudTextField T="string" @bind-Value="_group.Description" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
            <div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Color</MudText>
                <div class="gview-pipe-color-choices">
                    @foreach (var color in PipeWorkflowGroupColors.All)
                    {
                        <button type="button" class="gview-pipe-color-choice @(color == _group.Color ? "selected" : null)"
                                style="background:@PipeGroupVisuals.Accent(color)" title="@color" aria-label="@color"
                                @onclick="() => _group.Color = color"></button>
                    }
                </div>
            </div>
            <PipeEnvironmentSelect InheritText="@($"Inherit ({Environments.Instance} from the instance)")"
                                   HelperText="For the workflows of the group that don't set their own"
                                   @bind-Value="_group.Environment" />
            <PipeWorkflowSelect Label="Error workflow" InheritText="@ErrorInheritText" NoneValue="@PipeErrorWorkflows.None"
                                HelperText="Runs when a triggered run of a workflow in the group fails, unless the workflow sets its own"
                                @bind-Value="_group.ErrorWorkflowId" />
            <div>
                <MudText Typo="Typo.subtitle2">Variables</MudText>
                <PipeVariablesEditor @bind-Variables="_group.Variables"
                                     Description="For the workflows of the group; they override instance variables of the same name." />
            </div>
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>Group to edit; null creates a new one.</summary>
    [Parameter] public PipeWorkflowGroup? Group { get; set; }

    private PipeWorkflowGroup _group = new();
    private string? _error;

    private string ErrorInheritText { get; set; } = "Inherit (none)";

    protected override void OnInitialized()
    {
        // edit a copy, so Cancel leaves the caller's object untouched
        _group = Group is null ? new PipeWorkflowGroup() : PipeJson.Clone(Group);
    }

    protected override async Task OnInitializedAsync()
    {
        if (ErrorWorkflows.Instance is { } id)
        {
            var name = (await WorkflowStore.GetAsync(id))?.Name ?? id;
            ErrorInheritText = $"Inherit ({name} from the instance)";
        }
    }

    private async Task SaveAsync()
    {
        if (_group.Variables?.Select(v => PipeVariableNames.Validate(v.Name)).FirstOrDefault(e => e is not null) is { } invalid)
        {
            _error = $"Variables: {invalid}";
            return;
        }
        try
        {
            var created = string.IsNullOrEmpty(_group.Id);
            await GroupStore.SaveAsync(_group);
            await AuditLog.WriteAsync(Authorization, gView.Pipe.Abstraction.Audit.PipeAuditArea.Group, created ? "created" : "changed", _group.Id, _group.Name);
            Dialog.Close(DialogResult.Ok(_group));
        }
        catch (PipeException ex)
        {
            _error = ex.Message;
        }
    }
}
