@using gView.Pipe.Abstraction.Credentials
@inject IPipeCredentialStore CredentialStore
@inject IPipeCredentialTypeRegistry CredentialTypes
@inject IDialogService DialogService
@inject PipeEditorClipboard Clipboard
@inject ISnackbar Snackbar

<MudPaper Class="pa-4" Elevation="0" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h6">Credentials</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditAsync(null)">New credential</MudButton>
    </MudStack>

    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
        Credentials are stored encrypted. Nodes reference them by name in their parameters; secret values are never shown again after saving.
    </MudText>

    @if (_credentials is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_credentials.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">No credentials yet.</MudText>
    }
    else
    {
        <MudTable T="PipeCredentialInfo" Items="_credentials" Dense="true" Hover="true" Elevation="0">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Id</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Type">@(CredentialTypes.Find(context.TypeId)?.Name ?? "Unknown type")</MudTd>
                <MudTd DataLabel="Id">
                    <span class="gview-pipe-credential-id">@context.Id</span>
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" aria-label="Copy id" OnClick="() => CopyIdAsync(context.Id)" />
                </MudTd>
                <MudTd Style="text-align:right; white-space:nowrap">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Edit" OnClick="() => EditAsync(context)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="Delete" OnClick="() => DeleteAsync(context)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private IReadOnlyList<PipeCredentialInfo>? _credentials;

    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>Configuration (e.g. Pipe:Scripts:GitServers) refers to credentials by id.</summary>
    private async Task CopyIdAsync(string id)
        => Snackbar.Add(await Clipboard.TryWriteTextAsync(id) ? $"Copied '{id}'" : id, Severity.Info);

    private async Task LoadAsync() => _credentials = await CredentialStore.ListAsync();

    private async Task EditAsync(PipeCredentialInfo? credential)
    {
        var parameters = new DialogParameters<PipeCredentialDialog> { { d => d.CredentialId, credential?.Id } };
        var dialog = await DialogService.ShowAsync<PipeCredentialDialog>(
            credential is null ? "New credential" : "Edit credential",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        if (await dialog.Result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(PipeCredentialInfo credential)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete credential",
            $"Delete '{credential.Name}'? Nodes using it will fail until another credential is selected.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed == true)
        {
            await CredentialStore.DeleteAsync(credential.Id);
            await LoadAsync();
        }
    }
}
