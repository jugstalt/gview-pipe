@using System.Text.Json.Nodes
@using gView.Pipe.Abstraction.Credentials
@using gView.Pipe.Abstraction.Secrets
@inject IPipeCredentialStore CredentialStore
@inject IDialogService DialogService

@*
    Edits a parameter (or credential) JSON object in place, driven by the metadata of its class.
    Without a type the whole object is edited as raw JSON.
*@

@if (ParametersType is null)
{
    @if (Parameters.Count > 0 || ShowRawWithoutType)
    {
        <PipeRawJsonField Label="Parameters (JSON)" Value="Parameters" ValueChanged="ReplaceAllAsync" />
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">This node has no parameters.</MudText>
    }
}
else
{
    var fields = PipeParameterFields.For(ParametersType);
    var visible = fields.Where(f => PipeParameterFields.IsVisible(f, Parameters, fields)).ToList();
    var advanced = visible.Where(f => f.Advanced).ToList();
    <MudStack Spacing="3">
        @foreach (var field in visible.Where(f => !f.Advanced))
        {
            @FieldView(field)
        }
        @if (advanced.Count > 0)
        {
            <MudExpansionPanels Elevation="0" Outlined="true" Dense="true" Class="gview-pipe-advanced">
                <MudExpansionPanel Text="@($"Advanced ({advanced.Count})")" @bind-Expanded="_advancedOpen">
                    @if (_advancedOpen)
                    {
                        <MudStack Spacing="3">
                            @foreach (var field in advanced)
                            {
                                @FieldView(field)
                            }
                        </MudStack>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </MudStack>
}

@code {
    private bool _advancedOpen;

    /// <summary>One parameter's input, by its kind.</summary>
    private RenderFragment FieldView(PipeParameterField field) => @<text>
        @{

            var value = Parameters[field.Key];
            switch (field.Kind)
            {
                case PipeFieldKind.Boolean:
                    <MudSwitch T="bool" Label="@field.Label" Color="Color.Primary"
                               Value="@(value is JsonValue b && b.TryGetValue<bool>(out var flag) && flag)"
                               ValueChanged="v => SetAsync(field, JsonValue.Create(v))" />
                    break;

                case PipeFieldKind.Enum:
                    <MudSelect T="string" Label="@field.Label" Dense="true" Variant="Variant.Outlined" HelperText="@EnumHelperText(field, value)"
                               ToStringFunc="v => PipeParameterFields.EnumLabel(field, v)"
                               Value="@PipeJsonText.ToText(value)" ValueChanged="v => SetAsync(field, JsonValue.Create(v))">
                        @foreach (var option in field.EnumOptions)
                        {
                            <MudSelectItem Value="@option.Value">
                                <div>@option.Label</div>
                                @if (!string.IsNullOrEmpty(option.Description))
                                {
                                    <div class="gview-pipe-option-description">@option.Description</div>
                                }
                            </MudSelectItem>
                        }
                    </MudSelect>
                    break;

                case PipeFieldKind.Credential:
                    <MudSelect T="string" Label="@field.Label" Dense="true" Variant="Variant.Outlined" Clearable="true"
                               HelperText="@(field.Description ?? "Credentials are managed on the credentials page")"
                               Value="@PipeJsonText.ToText(value)" ValueChanged="v => SetAsync(field, string.IsNullOrEmpty(v) ? null : JsonValue.Create(v))">
                        @foreach (var credential in Credentials(field))
                        {
                            <MudSelectItem Value="@credential.Id">@credential.Name</MudSelectItem>
                        }
                    </MudSelect>
                    break;

                case PipeFieldKind.Option:
                    <PipeOptionSelectField Field="field" Value="@PipeJsonText.ToText(value)" Version="_version" OptionsProvider="OptionsProvider"
                                           ValueChanged="v => SetAsync(field, v is null ? null : JsonValue.Create(v))" />
                    break;

                case PipeFieldKind.SelectionList:
                    <PipeSelectionListField Field="field" Value="@(value as JsonArray)" Version="_version" OptionsProvider="OptionsProvider"
                                            ValueChanged="v => SetAsync(field, v)" />
                    break;

                case PipeFieldKind.Workflow:
                    <PipeWorkflowSelect Label="@(field.Required ? field.Label + " *" : field.Label)" HelperText="@field.Description"
                                        Value="@PipeJsonText.ToText(value)" ValueChanged="v => SetAsync(field, v is null ? null : JsonValue.Create(v))" />
                    break;

                case PipeFieldKind.Dictionary:
                    <PipeKeyValueField Field="field" Value="@(value as JsonObject)" ValueChanged="v => SetAsync(field, v)" OnExpressionFieldFocused="OnExpressionFieldFocused"
                                       ExpressionPreview="ExpressionPreview" />
                    break;

                case PipeFieldKind.List:
                    <PipeListField Field="field" Value="@(value as JsonArray)" ValueChanged="v => SetAsync(field, v)" OnExpressionFieldFocused="OnExpressionFieldFocused"
                                   ExpressionPreview="ExpressionPreview" />
                    break;

                case PipeFieldKind.FormFields:
                    <PipeFormFieldsField Field="field" Value="@(value as JsonArray)" ValueChanged="v => SetAsync(field, v)" />
                    break;

                case PipeFieldKind.RawJson:
                    <PipeRawJsonField Label="@field.Label" HelperText="@field.Description" Value="value" ValueChanged="v => SetAsync(field, v)" />
                    break;

                case PipeFieldKind.Text when field.Code:
                    <PipeCodeField Label="@(field.Required ? field.Label + " *" : field.Label)" HelperText="@field.Description" Language="@field.CodeLanguage"
                                   Value="@PipeJsonText.ToText(value)" ValueChanged="v => SetAsync(field, Convert(field, v))" />
                    break;

                default:
                    <div @onfocusin="() => FieldFocusedAsync(field)">
                    <MudTextField T="string" Immediate="true" DebounceInterval="300" Label="@(field.Required ? field.Label + " *" : field.Label)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Lines="@(field.Multiline ? 4 : 1)"
                                  InputType="@(field.Secret && !PipeSecretReference.IsReference(PipeJsonText.ToText(value)) ? InputType.Password : InputType.Text)"
                                  Adornment="@(field.Secret && AllowSecretSources ? Adornment.End : Adornment.None)"
                                  AdornmentIcon="@Icons.Material.Filled.Key" AdornmentAriaLabel="Use a secret of a source"
                                  OnAdornmentClick="() => PickSecretAsync(field)"
                                  Placeholder="@(field.Secret && SecretsArePlaceholders ? "(unchanged)" : field.Placeholder)"
                                  HelperText="@HelperText(field)"
                                  Class="@(field.Expressions ? "gview-pipe-expression-field" : null)"
                                  Value="@PipeJsonText.ToText(value)"
                                  ValueChanged="v => SetAsync(field, Convert(field, v))" />
                    @if (field.Expressions)
                    {
                        <PipeExpressionPreview Text="@PipeJsonText.ToText(value)" Preview="ExpressionPreview" />
                    }
                    </div>
                    break;
            }
        }
    </text>;

    /// <summary>The field's description and what the chosen value does.</summary>
    static private string? EnumHelperText(PipeParameterField field, JsonNode? value)
    {
        var text = PipeJsonText.ToText(value ?? field.DefaultValue);
        var chosen = field.EnumOptions.FirstOrDefault(o => string.Equals(o.Value, text, StringComparison.OrdinalIgnoreCase))?.Description;
        return string.IsNullOrEmpty(chosen) ? field.Description
            : string.IsNullOrEmpty(field.Description) ? chosen
            : $"{field.Description} · {chosen}";
    }

    /// <summary>Parameter or credential class; null for unknown node types.</summary>
    [Parameter] public Type? ParametersType { get; set; }

    [Parameter, EditorRequired] public JsonObject Parameters { get; set; } = new();

    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Secret fields are empty and mean "keep the stored value" (editing an existing credential).</summary>
    [Parameter] public bool SecretsArePlaceholders { get; set; }

    /// <summary>Secret fields get a button to take the value from a source instead (ADR 0033); for credentials.</summary>
    [Parameter] public bool AllowSecretSources { get; set; }

    private async Task PickSecretAsync(PipeParameterField field)
    {
        var dialog = await DialogService.ShowAsync<PipeSecretReferenceDialog>("Secret from a source",
            new DialogParameters<PipeSecretReferenceDialog> { { d => d.Value, PipeJsonText.ToText(Parameters[field.Key]) } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string reference })
        {
            // empty: back to a plain value
            await SetAsync(field, reference.Length == 0 ? null : JsonValue.Create(reference));
        }
    }

    [Parameter] public bool ShowRawWithoutType { get; set; }

    /// <summary>Values of option fields: (parameter, refresh) → options. Without it, option fields show no choices.</summary>
    [Parameter] public Func<string, bool, Task<IReadOnlyList<PipeParameterOption>>>? OptionsProvider { get; set; }

    // changes with every edit, so option fields reload when the parameters they depend on change
    private int _version;

    /// <summary>A text field that supports expressions got the focus (e.g. to insert expressions into it later).</summary>
    [Parameter] public EventCallback<PipeExpressionTarget> OnExpressionFieldFocused { get; set; }

    /// <summary>Value of an expression field for display (e.g. with the last run's input); null for none.</summary>
    [Parameter] public Func<string, string?>? ExpressionPreview { get; set; }

    private IReadOnlyList<PipeCredentialInfo> _credentials = [];

    protected override async Task OnParametersSetAsync()
    {
        if (ParametersType is not null && PipeParameterFields.For(ParametersType).Any(f => f.Kind == PipeFieldKind.Credential))
        {
            _credentials = await CredentialStore.ListAsync();
        }
    }

    private IEnumerable<PipeCredentialInfo> Credentials(PipeParameterField field)
        => _credentials.Where(c => field.CredentialTypeIds.Count == 0 || field.CredentialTypeIds.Contains(c.TypeId));

    static private string? HelperText(PipeParameterField field)
        => field.Expressions
            ? string.IsNullOrEmpty(field.Description) ? "Supports {{ }} expressions" : $"{field.Description} · supports {{{{ }}}} expressions"
            : field.Description;

    static private JsonNode? Convert(PipeParameterField field, string? text)
        => field.Kind switch
        {
            PipeFieldKind.Number => PipeJsonText.FromNumberText(text),
            PipeFieldKind.Json => PipeJsonText.FromLooseText(text),
            _ => text is null ? null : JsonValue.Create(text)
        };

    private Task FieldFocusedAsync(PipeParameterField field)
        => field.Expressions ? OnExpressionFieldFocused.InvokeAsync(new PipeExpressionTarget(field)) : Task.CompletedTask;

    private async Task SetAsync(PipeParameterField field, JsonNode? value)
    {
        Parameters[field.Key] = value;
        _version++;
        await OnChanged.InvokeAsync();
    }

    private async Task ReplaceAllAsync(JsonNode? value)
    {
        Parameters.Clear();
        if (value is JsonObject obj)
        {
            foreach (var (key, child) in obj.ToList())
            {
                obj.Remove(key);
                Parameters[key] = child;
            }
        }
        await OnChanged.InvokeAsync();
    }
}
