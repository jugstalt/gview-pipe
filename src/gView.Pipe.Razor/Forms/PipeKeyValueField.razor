@using System.Text.Json.Nodes

<div class="gview-pipe-collection-field">
    <MudText Typo="Typo.subtitle2">@Field.Label</MudText>
    @if (!string.IsNullOrEmpty(Field.Description))
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Field.Description</MudText>
    }

    @for (var i = 0; i < _rows.Count; i++)
    {
        var index = i;
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mt-1">
            <MudTextField T="string" Placeholder="Key" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Value="@_rows[index].Key" ValueChanged="v => UpdateAsync(index, v, _rows[index].Value)" />
            <div class="flex-grow-1" @onfocusin="() => FocusedAsync(index)">
            <MudTextField T="string" Placeholder="Value" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Class="@(Field.Expressions ? "gview-pipe-expression-field" : null)"
                          Value="@_rows[index].Value" ValueChanged="v => UpdateAsync(index, _rows[index].Key, v)" />
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="Remove" OnClick="() => RemoveAsync(index)" />
        </MudStack>
    }

    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="Add">Add</MudButton>
</div>

@code {
    [Parameter, EditorRequired] public PipeParameterField Field { get; set; } = default!;
    [Parameter] public JsonObject? Value { get; set; }
    [Parameter] public EventCallback<JsonNode?> ValueChanged { get; set; }

    /// <summary>The value input of an entry got the focus (expression fields only).</summary>
    [Parameter] public EventCallback<PipeExpressionTarget> OnExpressionFieldFocused { get; set; }

    private List<(string Key, string Value)> _rows = new();
    private JsonObject? _lastValue;

    protected override void OnParametersSet()
    {
        // rows hold unfinished input (e.g. a key without value), so only reload when the value is replaced from outside
        if (!ReferenceEquals(Value, _lastValue))
        {
            _rows = Value?.Select(p => (p.Key, PipeJsonText.ToText(p.Value))).ToList() ?? new();
            _lastValue = Value;
        }
    }

    private Task FocusedAsync(int index)
        => Field.Expressions && _rows[index].Key.Length > 0
            ? OnExpressionFieldFocused.InvokeAsync(new PipeExpressionTarget(Field, Key: _rows[index].Key))
            : Task.CompletedTask;

    private void Add() => _rows.Add(("", ""));

    private Task UpdateAsync(int index, string? key, string? value)
    {
        _rows[index] = (key ?? "", value ?? "");
        return PublishAsync();
    }

    private Task RemoveAsync(int index)
    {
        _rows.RemoveAt(index);
        return PublishAsync();
    }

    private async Task PublishAsync()
    {
        var result = new JsonObject();
        foreach (var (key, value) in _rows.Where(r => r.Key.Length > 0))
        {
            result[key] = Field.ItemKind == PipeFieldKind.Json ? PipeJsonText.FromLooseText(value) : JsonValue.Create(value);
        }
        _lastValue = result;
        await ValueChanged.InvokeAsync(result);
    }
}
