@using System.Text.Json.Nodes
@using gView.Pipe.Abstraction.Portal

@*
    Edits the fields of a Form Trigger (ADR 0027) as cards. The value stays a JSON array of objects with the
    properties of PipeFormField; properties the editor doesn't know are kept.
*@

<div class="gview-pipe-collection-field">
    <MudText Typo="Typo.subtitle2">@Field.Label</MudText>
    @if (!string.IsNullOrEmpty(Field.Description))
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Field.Description</MudText>
    }

    @for (var i = 0; i < _fields.Count; i++)
    {
        var index = i;
        var field = _fields[index];
        <MudPaper Outlined="true" Class="pa-2 mt-2">
            <MudStack Spacing="1">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudTextField T="string" Immediate="true" DebounceInterval="300" Label="Name *" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Error="@(NameError(index) is not null)" ErrorText="@NameError(index)"
                                  Value='@Text(field, "name")' ValueChanged='v => SetAsync(index, "name", v)' />
                    <MudSelect T="string" Label="Type" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Value="@TypeOf(field)" ValueChanged='v => SetAsync(index, "type", v)'>
                        @foreach (var type in Types)
                        {
                            <MudSelectItem Value="@type.Value">@type.Label</MudSelectItem>
                        }
                    </MudSelect>
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" aria-label="Move up" Disabled="@(index == 0)" OnClick="() => MoveAsync(index, -1)" />
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" aria-label="Move down" Disabled="@(index == _fields.Count - 1)" OnClick="() => MoveAsync(index, 1)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="Remove field" OnClick="() => RemoveAsync(index)" />
                </MudStack>
                <MudTextField T="string" Immediate="true" DebounceInterval="300" Label="Label" Variant="Variant.Outlined" Margin="Margin.Dense"
                              HelperText="Shown above the input; empty: the name"
                              Value='@Text(field, "label")' ValueChanged='v => SetAsync(index, "label", v)' />
                <MudTextField T="string" Immediate="true" DebounceInterval="300" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Value='@Text(field, "description")' ValueChanged='v => SetAsync(index, "description", v)' />
                @if (TypeOf(field) is not ("boolean" or "choice"))
                {
                    <MudTextField T="string" Immediate="true" DebounceInterval="300" Label="Placeholder" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Value='@Text(field, "placeholder")' ValueChanged='v => SetAsync(index, "placeholder", v)' />
                }
                @if (TypeOf(field) == "choice")
                {
                    <MudTextField T="string" Immediate="true" DebounceInterval="300" Label="Choices" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Lines="3" HelperText="One value per line"
                                  Value="@Choices(field)" ValueChanged="v => SetChoicesAsync(index, v)" />
                }
                @if (TypeOf(field) is "text" or "multilineText" or "password")
                {
                    <MudTextField T="string" Immediate="true" DebounceInterval="300" Label="Pattern (regular expression)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  HelperText="The text must match as a whole, e.g. [A-Z]{2}-\d{3,5}. Keep to what .NET and JavaScript share."
                                  Error="@(PatternError(field) is not null)" ErrorText="@PatternError(field)"
                                  Value='@Text(field, "pattern")' ValueChanged='v => SetAsync(index, "pattern", v)' />
                    @if (!string.IsNullOrEmpty(Text(field, "pattern")))
                    {
                        <MudTextField T="string" Immediate="true" DebounceInterval="300" Label="Message for a wrong value" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Value='@Text(field, "patternMessage")' ValueChanged='v => SetAsync(index, "patternMessage", v)' />
                    }
                }
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    @if (TypeOf(field) != "boolean")
                    {
                        <MudCheckBox T="bool" Color="Color.Primary" Label="Required"
                                     Value='@(field["required"] is JsonValue r && r.TryGetValue<bool>(out var required) && required)'
                                     ValueChanged='v => SetAsync(index, "required", v ? JsonValue.Create(true) : null)' />
                    }
                    <MudTextField T="string" Immediate="true" DebounceInterval="300" Label="Default" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Value='@Text(field, "default")' ValueChanged='v => SetAsync(index, "default", v)' />
                </MudStack>
            </MudStack>
        </MudPaper>
    }

    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">Add field</MudButton>
</div>

@code {
    static private readonly (string Value, string Label)[] Types =
    [
        ("text", "Text"), ("multilineText", "Multiline text"), ("number", "Number"), ("boolean", "Yes / no"),
        ("date", "Date"), ("choice", "Choice"), ("password", "Password")
    ];

    [Parameter, EditorRequired] public PipeParameterField Field { get; set; } = default!;
    [Parameter] public JsonArray? Value { get; set; }
    [Parameter] public EventCallback<JsonNode?> ValueChanged { get; set; }

    private List<JsonObject> _fields = [];
    private JsonArray? _lastValue;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Value, _lastValue))
        {
            _fields = Value?.OfType<JsonObject>().ToList() ?? [];
            _lastValue = Value;
        }
    }

    static private string Text(JsonObject field, string key) => field[key]?.ToString() ?? "";

    static private string TypeOf(JsonObject field)
        => Types.Any(t => string.Equals(t.Value, Text(field, "type"), StringComparison.OrdinalIgnoreCase))
            ? Types.First(t => string.Equals(t.Value, Text(field, "type"), StringComparison.OrdinalIgnoreCase)).Value
            : "text";

    static private string Choices(JsonObject field)
        => field["options"] is JsonArray options ? string.Join("\n", options.Select(o => o?.ToString())) : "";

    private string? NameError(int index)
    {
        var name = Text(_fields[index], "name");
        if (string.IsNullOrWhiteSpace(name))
        {
            return "Needed";
        }
        return _fields.Where((f, i) => i != index).Any(f => Text(f, "name") == name) ? "Used twice" : null;
    }

    static private string? PatternError(JsonObject field)
    {
        var pattern = Text(field, "pattern");
        if (pattern.Length == 0)
        {
            return null;
        }
        try
        {
            _ = PipeForm.Matches(pattern, "");
            _ = new System.Text.RegularExpressions.Regex(pattern);
            return null;
        }
        catch (ArgumentException ex)
        {
            return $"Not a valid expression: {ex.Message}";
        }
    }

    private Task SetAsync(int index, string key, string? value)
        => SetAsync(index, key, string.IsNullOrEmpty(value) ? null : JsonValue.Create(value));

    private Task SetAsync(int index, string key, JsonNode? value)
    {
        if (value is null)
        {
            _fields[index].Remove(key);
        }
        else
        {
            _fields[index][key] = value;
        }
        return PublishAsync();
    }

    private Task SetChoicesAsync(int index, string? text)
    {
        var values = (text ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return SetAsync(index, "options", values.Length == 0 ? null : new JsonArray(values.Select(v => (JsonNode?)JsonValue.Create(v)).ToArray()));
    }

    private Task AddAsync()
    {
        var number = 1;
        while (_fields.Any(f => Text(f, "name") == $"field{number}"))
        {
            number++;
        }
        _fields.Add(new JsonObject { ["name"] = $"field{number}", ["type"] = "text" });
        return PublishAsync();
    }

    private Task RemoveAsync(int index)
    {
        _fields.RemoveAt(index);
        return PublishAsync();
    }

    private Task MoveAsync(int index, int by)
    {
        (_fields[index], _fields[index + by]) = (_fields[index + by], _fields[index]);
        return PublishAsync();
    }

    private async Task PublishAsync()
    {
        // new nodes, so the array can take over objects that belong to the old one
        var result = new JsonArray(_fields.Select(f => (JsonNode?)f.DeepClone()).ToArray());
        _lastValue = result;
        await ValueChanged.InvokeAsync(result);
    }
}
