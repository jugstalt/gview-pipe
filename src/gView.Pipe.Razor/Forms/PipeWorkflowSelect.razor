@inject IPipeWorkflowStore WorkflowStore
@inject IPipeWorkflowGroupStore GroupStore

@* Picks a stored workflow by id. An id that no longer exists stays visible, so it isn't lost silently. *@

<MudSelect T="string" Label="@Label" Dense="true" Variant="Variant.Outlined" Clearable="true" HelperText="@HelperText"
           Value="@Value" ValueChanged="v => ValueChanged.InvokeAsync(string.IsNullOrEmpty(v) ? null : v)">
    @foreach (var workflow in _workflows)
    {
        <MudSelectItem Value="@workflow.Id">@Display(workflow)</MudSelectItem>
    }
    @if (!string.IsNullOrEmpty(Value) && _loaded && _workflows.All(w => w.Id != Value))
    {
        <MudSelectItem Value="@Value">Missing workflow '@Value'</MudSelectItem>
    }
</MudSelect>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Not offered, e.g. the workflow being edited.</summary>
    [Parameter] public string? ExcludeId { get; set; }

    private IReadOnlyList<PipeWorkflow> _workflows = [];
    private bool _loaded;
    private Dictionary<string, string> _groups = new();

    private string? GroupName(PipeWorkflow workflow)
        => workflow.GroupId is { } id ? _groups.GetValueOrDefault(id) : null;

    private string Display(PipeWorkflow workflow)
        => GroupName(workflow) is { } group ? $"{group} › {workflow.Name}" : workflow.Name;

    protected override async Task OnInitializedAsync()
    {
        _groups = (await GroupStore.ListAsync()).ToDictionary(g => g.Id, g => g.Name);
        // grouped by group (workflows without group first), so equal names in different groups can be told apart
        _workflows = (await WorkflowStore.ListAsync())
            .Where(w => w.Id != ExcludeId)
            .OrderBy(w => GroupName(w) ?? "", StringComparer.CurrentCultureIgnoreCase)
            .ThenBy(w => w.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        _loaded = true;
    }
}
