<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- tests are short; passing TestContext.Current.CancellationToken everywhere adds noise -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\gView.Pipe.Core\gView.Pipe.Core.csproj" />
    <ProjectReference Include="..\..\gView.Pipe.Plugins\gView.Pipe.Plugins.csproj" />
    <ProjectReference Include="..\..\gView.Pipe.AspNetCore\gView.Pipe.AspNetCore.csproj" />
    <ProjectReference Include="..\..\gView.Pipe.Cli\gView.Pipe.Cli.csproj" />
    <ProjectReference Include="..\..\gView.Pipe.Portal\gView.Pipe.Portal.csproj" />
    <!-- the Excel format: referenced directly here, the Shell loads it from its plugin folder -->
    <ProjectReference Include="..\..\gView.Pipe.Plugins.Office\gView.Pipe.Plugins.Office.csproj" AdditionalProperties="InstallPipePlugin=false" />
    <!-- the AI node: tested with a fake provider; the Shell loads the plugin from its plugin folder -->
    <ProjectReference Include="..\..\gView.Pipe.Plugins.AI\gView.Pipe.Plugins.AI.csproj" AdditionalProperties="InstallPipePlugin=false" />
    <!-- the Azure Blob node and trigger: tested with a fake storage; the Shell loads the plugin from its plugin folder -->
    <ProjectReference Include="..\..\gView.Pipe.Plugins.AzureStorage\gView.Pipe.Plugins.AzureStorage.csproj" AdditionalProperties="InstallPipePlugin=false" />
    <!-- the SFTP node: tested with a fake server; the Shell loads the plugin from its plugin folder -->
    <ProjectReference Include="..\..\gView.Pipe.Plugins.Sftp\gView.Pipe.Plugins.Sftp.csproj" AdditionalProperties="InstallPipePlugin=false" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\samples\workflows\*.json" Link="Samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
